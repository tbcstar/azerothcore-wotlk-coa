[worldserver]

# 启用/禁用法力风暴玩法模块（需要重启）。
Manastorm.Enable = 1

# 仅限 CoA 服务器（CoA.ClassModel = "coa"）。用集市代币替换常规宝箱。
# 奖励宝箱和其他奖励货币保持各自的发放规则。
# 启用前需应用 world/character 两个文件 rev_20261103_01_manastorm_coa_token_rewards.sql 和
# rev_20261104_02_manastorm_coa_encounter_rewards.sql。启用需要重启。
# 其余策略选项可重载。现有窗口保留其已保存的到期时间。
Manastorm.CoALootMode.Enabled = 0
Manastorm.CoALootMode.FirstClear.Enabled = 1
Manastorm.CoALootMode.Repeat.Enabled = 1
# 1 = 首通随个人窗口重置；0 = 终生首通。
# 首通按角色、深度、难度以及普通/终局路线分别计算。
Manastorm.CoALootMode.FirstClear.ResetWithWindow = 1
# 每个角色跨所有难度/路线共享。范围 0..1000000；0 停止代币奖励。
Manastorm.CoALootMode.TokenCap = 1000
# 窗口在首次符合条件的完成时开始，然后在这么多小时后过期（1..168）。
Manastorm.CoALootMode.WindowHours = 24
# 奖励金额/深度覆盖/里程碑在 manastorm_coa_token_rewards 中。

# 仅针对常规终局路线宝箱的每周上限，按角色计算并跨模式/层级共享。
# 练级和普通路线宝箱（包括60级）、首通奖励宝箱、
# 宝藏守护者宝箱、货币、箱子、卡包和贪婪恶魔奖励不受此限制。
# 使用核心每周任务重置时间表。两个选项均可重载。
Manastorm.WeeklyCacheLockout.Enabled = 1
# 有效范围：0..255；无效值会记录错误并回退到 5。
# 当 Enabled = 1 时，Limit = 0 会阻止所有常规终局宝箱奖励。
Manastorm.WeeklyCacheLockout.Limit = 5

# 自动词缀需要此阶段生物等级，并完成第一个原生词缀解锁深度。
# 个体进度词缀仍然需要其匹配的原生解锁/提示；这些深度保持不变。
Manastorm.AffixMinimumLevel = 50

# 倍增所有法力风暴经验：阶段生物击杀经验（在深度/原生修正之后）以及
# 从此刻起获得的地板完成经验。0.3 给予 30%（即减少 70%），1.0 为全额，0 为不给。
# 负数或无效值会记录错误并回退到 0.3。可重载。
Manastorm.ExperienceRate = 0.3

# 1 = 宝箱遵循 coa.conf 中的 Ascension.CallboardCache.ReleaseStage：
# 0 普通地下城，1 英雄地下城，2 史诗地下城，3 祖尔格拉布，4 熔火之心 ... 8 纳克萨玛斯。
# 已关闭的宝箱层级会回退到符合条件的最高较低区间；数据库深度/解锁要求仍然适用。
# 贪婪恶魔战利品使用由已发布的启用终局宝箱区间推导出的物品等级上限。
# 0 = 禁用发布阶段限制；现有的深度/解锁要求仍然适用。
# 可重载。
Manastorm.FollowReleaseStage = 1

# 客户端集成模式（需要重启）：
#   1 = 重建的 3.3.5 客户端插件传输（MANASTORM 插件前缀）
#   2 = 原始 Ascension 原生 Manastorm 协议（使用包含的 CoA 原生操作码桥接）
Manastorm.ClientMode = 2

# 现有的团队目标骷髅标记与可选的本地客户端高亮可以独立比较。
# NativeHighlight 使用现有的模式 2 Lua 传输；不安装任何客户端文件。
# 实验性：由客户端控制哪些生物符合条件以及几何体是否遮挡它们。
# 重新加载这些设置后请重新登录或更改阶段；本地高亮最多可能残留 10 秒。
Manastorm.Objective.RaidSkull = 1
Manastorm.Objective.NativeHighlight = 0

# 匹配原始客户端 Manastorm.dbc，在模式 2 下进行只读身份验证。
# 省略时的默认值：<DataDir>/dbc/Manastorm.dbc。
# Manastorm.NativeDBCPath = "C:/path/to/matching/Manastorm.dbc"
# 此模块独家拥有 Manastorm 请求和玩法。
# 兼容性捐赠者运行服务从不注册。
# AscensionCompat.Enable / 远程客户端准入仍为核心连接设置。

# 客户端 UI 修复以 Lua 形式在登录后 5 秒推送（仅限模式 2，无需客户端文件）。
# 只有具备热补丁通道的客户端（docs/coa/client-hot-patch.md）才会接收。
# 位掩码，0 = 关闭，客户端原生 UI 保持不变：
#   1 = 队伍查找器快捷键在法力风暴副本内也能打开
#   2 = 奖励图标锚定在潜在奖励分隔线下方
#   4 = 队列面板可处理空的"可进入等级"列表和未缓存的奖励物品
#   8 = 无配装法术时隐藏配装浮出菜单
#  15 = 以上全部
# 客户端在 /reload 后会重新运行这些修复。
Manastorm.ClientUIFixes = 0

# 原生机动性在模式 2 中自动覆盖所有 36 个列出的职业法术系。
# 运行时辅助光环跟随当前混合内容，并在离开你的 Manastorm 阶段后被移除。
# 需要匹配的 <DataDir>/dbc/Spell.dbc。无需客户端文件或 SQL 修改。
