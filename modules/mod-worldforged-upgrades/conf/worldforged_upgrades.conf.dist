[worldset]

#
#    Worldforged.CostFactor
#        说明：乘以每个升级价格。
#
#                     `worldforged_upgrade` 中的价格是计算出来的，不是
#                     恢复的。没有捕获的商店响应留存，也没有
#                     ItemExtendedCost 行命名 Worldforged 基础物品，因此
#                     数字来自公式：基础金额、暴雪自己的
#                     槽位权重和目标物品等级。此因子是
#                     一个旋钮，可以在不重新生成表的情况下调整它们全部。
#
#                     如果将来出现真实捕获，替换 `cost`
#                     列并将此项设回 1。
#        Default:     1.0
#

Worldforged.CostFactor = 1.0
