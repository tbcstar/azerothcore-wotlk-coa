[worldserver]

################################################################################################################
#    Dynamic.XP
#        Description: 服务器的固定经验倍率，玩家可以自行选择的倍率，
#                     以及关于它的提醒。
#
#        Dynamic.XP.Rate.Announce: 1（启用）在登录时告诉每个玩家他们的倍率
#                                  0（禁用）默认 - 全领域提醒已涵盖它
#
#        Dynamic.XP.Preset: 服务器倍率，也是每个尚未选择倍率的角色的默认值。
#                           在启动时和 ".reload config" 时读取，
#                           因此手动编辑此行即可生效。
#                           1（默认）= 无加成，3 = 每级三倍经验。
#                           未被 Dynamic.XP.Preset.Allowed 列出的倍率会回退到 1。
#
#        Dynamic.XP.Preset.Allowed: ".xp <rate>" 和 ".xp realm <rate>" 提供的倍率，
#                                   为逗号分隔的 1 到 31 的整数列表。
#                                   默认 "1,2,3,4,5"；1 始终提供。
#                                   存储了不在列表中的倍率的角色会在登录时被放回
#                                   服务器倍率并保持该值。
#
#        Dynamic.XP.Preset.PlayerChoice: 1（默认）允许玩家通过
#                                        ".xp <rate>" 和 ".xp default" 更改自己的倍率
#                                        0 = 仅限游戏管理员
#
#        Dynamic.XP.Reminder.*: 0 关闭重复；Message 按原样发送（包含颜色代码等）。
#                               空的 Message 会自行列出提供的倍率。
#                               当玩家登录时会公告，
#                               之后每隔 Interval分钟公告一次，
#                               对象是未禁用自动
#                               公告的玩家。
#

Dynamic.XP.Rate.Announce = 0

Dynamic.XP.Preset = 1

Dynamic.XP.Preset.Allowed = "1,2,3,4,5"

Dynamic.XP.Preset.PlayerChoice = 0

Dynamic.XP.Reminder.Enable = 0

Dynamic.XP.Reminder.Interval = 40

Dynamic.XP.Reminder.Message = ""

##################################################################################################################
