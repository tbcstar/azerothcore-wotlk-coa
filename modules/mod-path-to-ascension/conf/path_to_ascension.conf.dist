###################################################################################################
#  mod-path-to-ascension
#
#  飞升之路：Ascension 客户端的教程书（Tutorial.dbc 及其配套表），带有已验证的目标进度、
#  一次性奖励和可选的任务日志追踪视图。
#
#  该模块在启动时从 DataDir/dbc 读取 Tutorial.dbc、TutorialCategories.dbc、
#  TutorialObjectives.dbc 和 TutorialRewards.dbc。缺失或不同的目录会禁用该模块并报错；
#  它绝不会替换客户端数据。
#
#  进度保存在角色的 core.ascension.* 设置中。所有选项在启动时读取。
#
#  此代码是 AzerothCore 项目的一部分。版权信息请参见 AUTHORS 文件。
###################################################################################################

[worldserver]

#    PathToAscension.Enable
#        Description: 加载教程目录并运行飞升之路。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
PathToAscension.Enable = 1

#    PathToAscension.RealmProfile
#        Description: Tutorial.dbc 中决定该服务器提供哪些教程的服务器列：
#                     0 - 正式服，1 - 赛季服，2 - 联赛服，3 - PTR，4 - 开发服。
#                     已安装的目录与 Rexxar PTR 数据匹配，因此 PTR 提供完整集合。
#                     此处提供但客户端自身服务器类型（CoA.RealmType）
#                     隐藏的教程会在登录时对客户端可见。
#        Default:     3 - (PTR)
PathToAscension.RealmProfile = 3

#    PathToAscension.Expansion
#        Description: 本服务器提供的教程变体所属的资料片。其他资料片的教程
#                     对客户端隐藏，而本资料片的教程无论客户端从 MaxPlayerLevel
#                     推导出哪个资料片都会显示。原版游戏中的奥妮克希亚的巢穴和纳克萨玛斯教程
#                     在这些团队副本作为巫妖王之怒内容运行时保持隐藏，
#                     而史诗钥石地下城教程在服务器没有史诗钥石地下城时也保持隐藏。
#                     -1 - 跟随 worldserver 的 Expansion 选项
#                      0 - 经典旧世，1 - 燃烧的远征，2 - 巫妖王之怒
#        Default:     0 - （经典旧世）
PathToAscension.Expansion = 0

#    PathToAscension.VerifiedProgress.Enable
#        Description: 从模块观察到的服务器事件记录目标进度。
#        Default:     1 - (Enabled)
PathToAscension.VerifiedProgress.Enable = 1

#    PathToAscension.Rewards.Enable
#        Description: 响应客户端的奖励领取。每个奖励每个角色只授予一次。
#        Default:     1 - (Enabled)
PathToAscension.Rewards.Enable = 1

#    PathToAscension.Tracking.Enable
#        描述：提供教程的任务日志追踪视图。它们随教程完成而完成，并在领取其奖励时移除；
#                     它们本身从不支付奖励。
#        Default:     1 - (Enabled)
PathToAscension.Tracking.Enable = 1

#    PathToAscension.LegacyContent.Enable
#        Description: 同时提供比 PathToAscension.Expansion 更早的资料片中已恢复的团队副本和装备教程。
#                     它们的目标和奖励保持不变。
#        Default:     0 - (Disabled)
PathToAscension.LegacyContent.Enable = 0

#    PathToAscension.StarterMountBridge.Enable
#        描述：骑术训练师在角色学会初级骑术后，一次性交给它其种族的初始坐骑，
#                     以便初始坐骑教程可以完成。
#        Default:     0 - (Disabled)
PathToAscension.StarterMountBridge.Enable = 0
