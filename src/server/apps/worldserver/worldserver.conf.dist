###################################################################################################
# GAME MASTER-游戏管理员
#
#    GM.LoginState
#        说明：登录时的 GM 模式。
#        默认：2 - （上次保存状态）
#                     0 - （禁用）
#                     1 - （启用）

GM.LoginState = 2

#
#    GM.Visible
#        说明：登录时的 GM 可见性。
#        默认：2 - （上次保存状态）
#                     0 - （隐身）
#                     1 - （可见）

GM.Visible = 2

#
#    GM.Chat
#        说明：登录时的 GM 聊天模式。
#        默认：2 - （上次保存状态）
#                     0 - （禁用）
#                     1 - （启用）

GM.Chat = 1

#
#    GM.WhisperingTo
#        说明：默认情况下 GM 是否接受玩家的密语。
#        默认：2 - （上次保存状态）
#                     0 - （禁用）
#                     1 - （启用）

GM.WhisperingTo = 1

#
#    GM.InGMList.Level
#        说明：在非 GM 状态（.gm off）下，GM 列表中显示的最大 GM 等级（如果启用）。
#        默认：3 - （任何人）
#                     0 - （仅玩家）
#                     1 - （仅版主）
#                     2 - （仅游戏管理员）

GM.InGMList.Level = 3

#
#    GM.InWhoList.Level
#        说明：在 who 列表中显示的最大 GM 等级（如果可见）。
#        默认：3 - （任何人）
#                     0 - （仅玩家）
#                     1 - （仅版主）
#                     2 - （仅游戏管理员）

GM.InWhoList.Level = 3

#
#    GM.StartLevel
#        Description: GM 角色起始等级。
#        Default:     1

GM.StartLevel = 1

#
#    GM.AllowInvite
#        Description: 允许玩家邀请 GM 角色。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

GM.AllowInvite = 0

#
#    GM.AllowFriend
#        Description: 允许玩家将 GM 角色添加到他们的好友列表。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

GM.AllowFriend = 0

#
#    GM.LowerSecurity
#        Description: 允许较低安全级别
#                     对较高安全级别的角色使用命令。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

GM.LowerSecurity = 0

#
#    GM.TicketSystem.ChanceOfGMSurvey
#        Description: 工单完成后发送 GM 调查的机会。
#        Default:     50 - (Enabled)
#                     0  - (Disabled)

GM.TicketSystem.ChanceOfGMSurvey = 50

#
###################################################################################################

###################################################################################################
# CHEAT-作弊
#
#    DisableWaterBreath
#        说明：水下呼吸所需的安全级别。
#        默认：4 - （禁用）
#                     0 - （启用，所有人）
#                     1 - （启用，Mods/GMs/Admins）
#                     2 - （启用，GMs/Admins）
#                     3 - （启用，Admins）

DisableWaterBreath = 4

#
#    AllFlightPaths
#        Description: 角色创建后知道所有飞行路径（两个阵营的）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AllFlightPaths = 0

#
#    InstantFlightPaths
#        Description: 飞行路径将立即将玩家带到目的地，
#                     而不是让他们等待飞行。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#                     2 - (Enabled, but the player can toggle instant flight off or on at each flight master)

InstantFlightPaths = 0

#
#    AlwaysMaxSkillForLevel
#        Description: 玩家在登录或升级时
#                     自动获得最大技能等级。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AlwaysMaxSkillForLevel = 0

#
#    AlwaysMaxWeaponSkill
#        Description: 玩家在登录或升级时
#                     自动获得最大武器/防御技能。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AlwaysMaxWeaponSkill = 0

#
#    PlayerStart.AllReputation
#        Description: 玩家将以大多数所需的高等级声望开始，
#                     用于物品、坐骑等。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PlayerStart.AllReputation = 0

#
#    PlayerStart.CustomSpells
#        Description: 如果启用，
#                     玩家将以 playercreateinfo_spell_custom 表中定义的自定义法术开始。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PlayerStart.CustomSpells = 0

#
#    PlayerStart.MapsExplored
#        Description: 角色以所有地图已探索开始。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PlayerStart.MapsExplored = 0

#
###################################################################################################

###################################################################################################
# ACCOUNT-账户
#
#    Trial.LevelCap
#        Description: 试玩账户可达到的最大等级。一旦达到此等级，经验获取停止。
#        Default:     20
#                     0  - (Disabled, no cap)

Trial.LevelCap = 20

#
#    Trial.MoneyCap
#        Description: 试玩账户可持有的最大金钱，以铜币为单位。
#        Default:     100000 - (10 gold)
#                     0      - (Disabled, no cap)

Trial.MoneyCap = 100000

#
#    Trial.TradeSkillCap
#        Description: 试玩账户任何专业技能可达到的最大值。
#        Default:     100
#                     0   - (Disabled, no cap)

Trial.TradeSkillCap = 100

#
#    Trial.Restriction.Chat
#        Description: 限制试玩账户使用密语/频道/公会聊天。
#                     仅当试玩玩家在收件人好友列表中或试玩账户先被密语时，
#                     才允许密语。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Chat = 1

#
#    Trial.Restriction.Mail
#        Description: 限制试玩账户发送邮件。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Mail = 1

#
#    Trial.Restriction.Trade
#        Description: 限制试玩账户发起或成为游戏内交易的目标。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Trade = 1

#
#    Trial.Restriction.Auction
#        Description: 限制试玩账户在拍卖行出售、竞标或取消拍卖。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Auction = 1

#
#    Trial.Restriction.Party
#        Description: 限制试玩账户邀请玩家加入队伍，
#                     以及接受现有成员等级高于 Trial.LevelCap 的队伍邀请。
#                     当 Trial.LevelCap 为 0 时跳过加入检查。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Party = 1

#
#    Trial.Restriction.Guild
#        Description: 限制试玩账户加入公会（接受邀请）
#                     和创建公会（购买、签署或提交公会章程）。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Guild = 1

#
#    Trial.Restriction.Queue
#        Description: 强制试玩账户通过世界会话队列，
#                     即使他们的账户标志本来会授予跳过队列优先级。
#                     RBAC_PERM_SKIP_QUEUE 权限和最近断开宽限仍然有效。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Trial.Restriction.Queue = 1

#
###################################################################################################

###################################################################################################
# CHARACTER DATABASE-角色数据库
#
#    PlayerSaveInterval
#        Description: 玩家保存间隔的时间（毫秒）。
#        Default:     900000 - (15 min)

PlayerSaveInterval = 900000

#
#    PlayerSave.Stats.MinLevel
#        说明：在数据库中保存角色属性以供外部使用的最低等级。
#        默认：0  - （禁用，不保存角色属性）
#                     1+ - （启用，超过此等级保存角色属性）

PlayerSave.Stats.MinLevel = 10

#
#    PlayerSave.Stats.SaveOnlyOnLogout
#        说明：仅在注销时保存玩家属性。
#        默认：1 - （启用，仅在注销时保存）
#                     0 - （禁用，每次玩家保存时保存）

PlayerSave.Stats.SaveOnlyOnLogout = 1

#
#    PlayerSave.AdditionalSaves
#        Description: 在重要更改后几秒钟内将玩家数据保存到数据库的位掩码，
#                     而不是等待下一个定期保存（PlayerSaveInterval）。
#                     减少服务器崩溃时丢失的进度。
#                     组合值以启用多个触发器。
#        值：1 - 物品栏和金币（拾取稀有或更高质量物品后）
#                     2 - 任务状态（任务状态更改后）
#                     4 - 成就（完成成就后）
#        默认：0 - （禁用）
#                     7 - （以上所有）

PlayerSave.AdditionalSaves = 7

#
#    CleanCharacterDB
#        Description: 从数据库中清理已弃用的成就、技能、法术和天赋。
#        Default:     0 - (Disabled)
#                     1 - (Enable)

CleanCharacterDB = 0

#
#    PersistentCharacterCleanFlags
#        Description: 确定清理后保留的角色清理标志。
#                     这是一个位掩码值，你可以使用以下值之一：
#
#                     CLEANING_FLAG_ACHIEVEMENT_PROGRESS  = 0x1
#                     CLEANING_FLAG_SKILLS                = 0x2
#                     CLEANING_FLAG_SPELLS                = 0x4
#                     CLEANING_FLAG_TALENTS               = 0x8
#                     CLEANING_FLAG_QUESTSTATUS           = 0x10
#        Note:        使用此功能前，请备份数据库。
#        Example:     14 - (CLEANING_FLAG_SKILLS + CLEANING_FLAG_SPELLS + CLEANING_FLAG_TALENTS
#                          2+4+8 => 14. 这将清理技能，天赋和法术
#                          将在下次清理后保持启用)
#        Default:     0  - (下次清理后所有清理方法将被禁用)

PersistentCharacterCleanFlags = 0

#
###################################################################################################

###################################################################################################
# CHARACTER DELETE-角色删除
#
#    CharDelete.Method
#        Description: 角色删除行为。
#        Default:     1 - （将角色从账号中解除关联并释放该名称，在游戏中显示为已删除；
#                         在 CharDelete.KeepDays 过期之前可恢复）
#                     0 - （从数据库中完全移除角色）

CharDelete.Method = 0

#
#    CharDelete.MinLevel
#        说明：如果启用，使用取消链接方法所需的等级。
#        默认：0  - （每个等级使用相同方法）
#                     1+ - （仅指定等级的角色将使用取消链接方法）

CharDelete.MinLevel = 0

#
#    CharDelete.KeepDays
#        说明：未链接角色从数据库中移除之前的时间（以天为单位）。
#        默认：30 - （启用）
#                     0  - （禁用，不删除任何角色）

CharDelete.KeepDays = 30

#
###################################################################################################

###################################################################################################
# CHARACTER CREATION-角色创建
#
#    MinPlayerName
#        Description: 最小玩家名称长度。
#        Range:       1-12
#        Default:     2

MinPlayerName = 2

#
#    MinPetName
#        Description: 最小宠物名称长度。
#        Range:       1-12
#        Default:     2

MinPetName = 2

#
#    DeclinedNames
#        说明：允许俄罗斯客户端设置和使用变格名称。
#        默认：0 - （禁用，除非设置了俄罗斯 RealmZone）
#                     1 - （启用）

DeclinedNames = 0

#
#    StrictNames.Reserved
#        说明：使用 DBC 中的保留过滤器。
#                     防止玩家、宠物和公会章程名称包含保留名称。
#        默认：1 - 启用
#                     0 - 禁用

StrictNames.Reserved = 1

#
#    StrictNames.Profanity
#        说明：使用 DBC 中的脏话过滤器。
#                     防止玩家、宠物和公会章程名称包含脏话。
#        默认：1 - 启用
#                     0 - 禁用

StrictNames.Profanity = 1

#
#    StrictPlayerNames
#        说明：将玩家名称限制为语言特定的符号集。如果使用了不允许的符号，
#                     阻止角色创建并强制重命名请求
#        默认：0 - （禁用，有限的服务器时区相关客户端检查）
#                     1 - （启用，严格基本拉丁字符）
#                     2 - （启用，严格领域区域特定，参见 RealmZone 设置，
#        注意：客户端需要安装支持该字符集的适当字体。
#                     对于非官方本地化，
#                     自定义字体需要放置在 clientdir/Fonts。）
#                     3 - （启用，基本拉丁字符 + 服务器时区特定）

StrictPlayerNames = 0

#
#    StrictPetNames
#        说明：将宠物名称限制为语言特定的符号集。
#                     如果使用了不允许的符号，阻止宠物命名。
#        默认：0 - （禁用，有限的服务器时区相关客户端检查）
#                     1 - （启用，严格基本拉丁字符）
#                     2 - （启用，严格领域区域特定，参见 RealmZone 设置，
#        注意：客户端需要安装支持该字符集的适当字体。
#                     对于非官方本地化，
#                     自定义字体需要放置在 clientdir/Fonts。）
#                     3 - （启用，基本拉丁字符 + 服务器时区特定）

StrictPetNames = 0

#
#    CharacterCreating.Disabled
#        说明：基于阵营禁用玩家角色创建。
#        默认：0 - （启用，允许所有阵营）
#                     1 - （禁用，联盟）
#                     2 - （禁用，部落）
#                     3 - （禁用，两个阵营）

CharacterCreating.Disabled = 0

#
#    CharacterCreating.Disabled.RaceMask
#        说明：玩家不能创建的种族掩码。
#        示例：1536 - （1024 + 512，血精灵和德莱尼种族被禁用）
#        默认：0    - （启用，允许所有种族）
#                     1    - （禁用，人类）
#                     2    - （禁用，兽人）
#                     4    - （禁用，矮人）
#                     8    - （禁用，暗夜精灵）
#                     16   - （禁用，亡灵）
#                     32   - （禁用，牛头人）
#                     64   - （禁用，侏儒）
