###################################################################################################

###################################################################################################
# COMMAND-命令
#
#    AllowPlayerCommands
#        Description: 允许玩家使用命令。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AllowPlayerCommands = 1

#
#    Command.LookupMaxResults
#        Description: 使用 .lookup 命令显示的结果数量。
#        Default:     0 - (无限制)

Command.LookupMaxResults = 0

#
#    Die.Command.Mode
#        Description: 不触发来自 .die 命令的战利品等。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Die.Command.Mode = 1

