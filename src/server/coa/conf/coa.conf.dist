#
# CoA：Ascension 客户端兼容性
#

[worldserver]

# 启用兼容性数据包过滤器。
CoA.Enable = 1

# 将 Ascension 协议设置应用于远程连接以及回环连接
# （扩展操作码、ping 间隔、法术修改器布局、职业 10 映射）。
# 仅在对应该 Ascension 客户端版本的专用服务器上启用。
# 身份验证证明和数据包大小检查仍然需要。重启以应用。
CoA.AllowRemoteClients = 1

# Ascension 的无职业角色创建器提交职业 ID 10（英雄）
# 1 - 改为创建一个原版战士空壳。
# 0 - 创建一个英雄。在 CoA.ClassModel = "hero" 的服务器上使用此项。
CoA.MapClass10ToWarrior = 1

# 在协议发现期间记录每个消耗的扩展数据包。
CoA.LogConsumedPackets = 1

# Ascension 角色屏幕：启用/禁用（激活/停用）以及
# 每个账户的角色列表排序顺序。
# 请求：CMSG 0x072E / 0x072F / 0x0772。
# 响应：SMSG 0x075E / 0x075F / 0x0760 / 0x076F / 0x0770 / 0x0771。
CoA.CharacterSelectionEnable = 1

# 每个账号同时激活的最大角色数量（1-128）。
# 已停用的角色仍会被保存，并从标准角色列表中隐藏，
# 之后可以重新激活。
CoA.CharacterSelectionMaxActive = 128

# 自动为角色获得的物品添加外观和装饰条目。
CoA.AutoCollectAppearances = 1

# 在获得奖励的击杀中，最多掉落一件与敌人可见装备相匹配的可穿戴物品。
# 使用 NPC 显示预设或 CreatureDisplayInfoExtra，外加当前武器/盾牌条目。
# 只有未绑定/装备后绑定、品质不高于优秀、且等级不高于敌人等级的装备才符合条件。
# 属性优先选择施法者智力、防御者的防御/耐力，或物理力量/敏捷。
# 每次击杀的百分比是本地重建的默认值；原始概率未被记录。
CoA.EquippedGearLoot = 1
CoA.EquippedGearLootChance = 5

# 机器人所扮演角色的衣橱、套装、外观以及坐骑/小伙伴收藏。
# 0 - 从不：机器人会话跳过这些收藏（默认）。
# 1 - 仅玩家账号中作为机器人扮演的角色（小号），绝不包含随机机器人账号：
#     它们保存的套装和外观会像玩家一样被应用。
# 2 - 每个机器人会话。
# 随机机器人账号通过其名字前缀 CoA.RandomBotAccountPrefix 来识别，该前缀
# 必须与 mod-playerbots 的 AiPlayerbot.RandomBotAccountPrefix 匹配（默认：rndbot）。
CoA.CollectionsForBots = 0
CoA.RandomBotAccountPrefix = "rndbot"

# 单人服务器便利：解锁完整的本地外观目录。
# 每个类别的值用于平衡初始快照；剩余的幻化外观随后以流式传输，
# 以保持在旧版客户端 64 KiB 数据包限制之下。
CoA.UnlockLocalAppearanceCatalog = 1
CoA.AppearanceCatalogPerCategory = 500

# 单人服务器便利：将每个静态 VanityCollection 条目公开为账户所有。
# 仅限 Ascension 的自定义条目仍然需要匹配的服务器物品/法术模板才能交付。
CoA.UnlockAllVanity = 1

# 如果装饰物品没有服务器物品模板，但其 DBC 行指定了有效的法术，
# 则在请求交付时直接学习该法术。
CoA.AllowLearnedSpellDelivery = 1

# 永久教授已拥有的装饰坐骑/伙伴法术，以小的登录批次进行。
# 所有权保持不变。没有本地法术的条目不会被虚构。
CoA.LearnOwnedCompanions = 1

# 单人服务器便利：从首次登录起所有骑术等级（300/300）和寒冷天气飞行，
# 包括一级角色。不授予专业。
CoA.MaxRidingFromStart = 1

# 为在登录时未携带三种 PvP 规则集光环中任何一种的角色授予 PvE 设置，
# 因为角色创建不授予规则集，且客户端的选择界面受等级和休息区域限制。
# PvE 设置就是单独的 PvE 模式光环 9931032，与按下“PvE 模式”所应用的完全相同。
# 与此设置无关，
# 携带战争模式光环 1004119 与 PvE 模式并存时，该角色在登录时会失去战争模式光环。
# 设为 0 可将此类角色保留在 Ruleset.None 上。
CoA.RulesetLoginDefault = 1

# 低级任务会报告玩家等级，并使用匹配的 QuestXP 行。
# 已经高于玩家的任务仍然更高。共享的任务模板不可更改。
CoA.QuestLevelScaling = 1

# 由等级缩放生物掉落的武器和护甲、由选择等级缩放的角色在宝箱中找到的，或由等级缩放任务给予的，
# 会被提升到该内容的等级，向下取整到五级一档，作为条目从 4400001 开始的副本。
# 衬衣、战袍和没有物品等级的物品保持原样。
# 设为 0 以停止新的提升；
# 已经发放的副本仍然有效。
CoA.ItemScaling = 1

# 自动进阶：在角色升级时，为其职业和等级发放职业能力和等级升级。
# 设为 0 以停止该功能并让玩家自行请求——一本《飞之书》会授予它们，
# 因此如果某个服务器
# 希望以书籍作为获得能力的方式，则关闭此选项。
# 天赋树的免费节点无论如何都会授予：书籍并不出售它们。可重载。
CoA.AutoProgression = 0

# 流式传输已安装的 Ascension 客户端无法从其自身文件中解析的 CreatureDisplayInfo 补丁行
# （自定义显示 ID）。该流在客户端扩展握手之后开始，
# 如果始终未到达，则有一个简短的登录回退。
CoA.SendDisplayPatches = 1

# 客户端 CreatureDisplayInfo.dbc 的未打补丁副本，用于精确流式传输
# 客户端缺失的行。留空则选择 DataDir/dbc_clientset；当该副本不可用时，
# 改为流式传输所有大于等于 652000 的显示 ID。
CoA.ClientDbcDirectory = ""

# 从已安装客户端的操作码分发表中导出的扩展范围。
# 请保持这些值为十进制，因为 ConfigMgr 数值会按十进制解析。
CoA.FirstExtensionOpcode = 1311
CoA.LastExtensionOpcode = 2515

# 实验性本地 Manastorm。需要匹配的角色迁移和客户端 UI 补丁。
# 仅启动时：单人等级 10-59，三个场景，深度 1-15。领域等级上限不变。
# 仅在经过审查的安装包中启用；仍然需要原生游戏验收。
Ascension.Manastorm.Enable = 0

# 客户端被告知它所在的服务器类型：可以是 live (正式服)、seasonal (赛季服) 、league(联赛)、ptr（公共测试服）
# 和development 中的一个或多个，用空格分隔。发送的每种类型都会打开客户端中
# 标记为该类型的行，因此 "live seasonal" 会同时显示两者的角色成长条目，
# 就像在正式基础设施上的赛季服务器一样。
# 空值或未知值会发送 live。
#
# 这不是装饰性的。
# 客户端仅从匹配活动领域类型的行构建其装饰目录，
# 因此如果没有设置，无论账户拥有什么，装饰收藏都会保持为空。
# Default: live
CoA.RealmType = "live"

#
#    CoA.ClassModel
#        说明：在请求角色列表时，通过 SMSG_REALM_INFO 向客户端通告的
#                     角色创建模式。
#                     "coa"  - Conquest of Azeroth 职业。默认。
#                     "wcr"  - Warcraft Reborn（经典）职业。
#                     "hero" - 自由选择英雄。
#        Default:     "coa"
#

CoA.ClassModel = "coa"

#
#    CoA.GameModeMask
#        Description: 角色登录时发送给客户端的自定义游戏模式位，用于开启对应的客户端 UI 和规则。
#                     添加数值可以组合多个模式。
#                     2    - 铁人
#                     4    - 生存专家
#                     8    - 轮抽
#                     32   - 坚定
#                     64   - 外卡
#                     128  - 邪能锻造
#                     256  - 梦魇
#                     2048 - 构筑轮抽
#                     4096 - 十字军
#        默认值：     0 - 无自定义游戏模式
#

CoA.GameModeMask = 0

#
#    CoA.ClientBooleanConfigs
#    CoA.ClientIntegerConfigs
#        Description: 通过 SMSG_COA_CONFIG 发送的额外客户端配置，格式为逗号分隔的 NAME=value list.
#                     它们用于选择服务器特定的客户端 UI，例如
#                     "CONFIG_LEGACY_CHARACTER_ADVANCEMENT_ENABLED=0" 会在自由选择服务器上
#                     加载当前的角色进阶界面，而不是第 9 赛季的界面。
#        Default:     "" - none
#

CoA.ClientBooleanConfigs = ""
CoA.ClientIntegerConfigs = ""

###################################################################################################
# HIGH-RISK PACKAGE-高风险包
#
#    HighRisk.Losses
#        说明：在高风险规则集（光环 1004019）下，开放世界中的死亡会将
#                     可交易装备、背包资源和金币移入一个持久宝箱，附近任何
#                     存活的高风险玩家都可以取回。击杀经验不变：规则集
#                     光环已经携带原生奖励。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.Losses = 1

#    HighRisk.GearChance
#    HighRisk.ResourceChance
#    HighRisk.GoldChance
#        说明：每次符合条件的死亡，每个类别丢失的百分比几率。领域调整，
#                     不是已验证的 Ascension 速率。如果所有掷骰都未命中，仍然会
#                     选择一个可用类别，因此符合条件的死亡永远不会静默地不产生宝箱。
#        Default:     50

HighRisk.GearChance = 50
HighRisk.ResourceChance = 50
HighRisk.GoldChance = 50

#    PvpPower.Enable
#        说明：名为“PvP Power (+N)”的物品法术在 60 级时缩放伤害和治疗，上限为
#                     495 点。对玩家（以及开放世界中高风险攻击者对不受控
#                     生物）的伤害每点 +0.05%；在那里受到的生物伤害
#                     每点 -0.05%；战争模式、高风险开放世界和战场中
#                     治疗和护盾每点 +0.02%。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PvpPower.Enable = 0

#    Bloodforged.Enable
#        说明：为 15 级及以上的高风险玩家，向符合条件的开放世界生物尸体
#                     添加一次独立的 Bloodforged 掷骰，从 coa_bloodforged_catalogue
#                     中经过审查的目录中抽取。需要 PvpPower.Enable。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Bloodforged.Enable = 0

#    Bloodforged.Rates15
#    Bloodforged.Rates25
#    Bloodforged.Rates35
#    Bloodforged.Rates45
#    Bloodforged.Rates55
#        说明：从该等级开始的等级段，每个符合条件尸体的百分比，作为三个
#                     值：优秀、稀有、史诗。独立掷骰，每次掷骰一个品质。
#        Default:     "4.50 0.50 0.00", "4.00 1.00 0.00", "3.80 1.40 0.15", "3.60 1.80 0.25", "3.40 2.20 0.40"

Bloodforged.Rates15 = "4.50 0.50 0.00"
Bloodforged.Rates25 = "4.00 1.00 0.00"
Bloodforged.Rates35 = "3.80 1.40 0.15"
Bloodforged.Rates45 = "3.60 1.80 0.25"
Bloodforged.Rates55 = "3.40 2.20 0.40"

#
#    Ascension.PrestigiousCache.ReleaseStage
#        说明：领域已发布的最新层级，1-6。一个 Prestigious Cache 只支付
#                     其自身内容的令牌，并且永远不会支付高于此层级的令牌，
#                     因此 Classic 阶段的领域永远不会发放 Tier 6 令牌。
#                     Tier2.5 计为 2.5，所以 3 仍然覆盖它。
#        Default:     6

Ascension.PrestigiousCache.ReleaseStage = 6

#
#    Ascension.PrestigiousCache.TokenChancePercent
#        Description: Prestigious Cache 同时交出自身层级令牌的几率，
#                     正如该 cache 自己的描述所说，
#                     “如果层级已发布，有机会获得一个或多个全局层级令牌”。
#                     内容没有自己令牌的 cache 不支付任何令牌。
#        Default:     25

Ascension.PrestigiousCache.TokenChancePercent = 25

#
#    Ascension.PrestigiousCache.SecondTokenChancePercent
#        Description: 第一个令牌变为两个的几率。
#        Default:     5

Ascension.PrestigiousCache.SecondTokenChancePercent = 5

#
#    Ascension.PrestigiousCache.ClassicStages
#        说明：已发布多少个 Classic Prestigious Cache，0-8，按顺序
#                     1287304 依次对应英雄地下城、祖尔格拉布、熔火之心、
#                     奥妮克希亚、黑翼之巢、安其拉废墟、安其拉神殿、
#                     纳克萨玛斯。通用的“最近可用的 Prestigious Cache”
#                     解析为最新发布的那个。
#        Default:     8

Ascension.PrestigiousCache.ClassicStages = 8

#
#    Ascension.PrestigiousCache.TbcStages
#        Description: 已发布多少个燃烧的远征 Prestigious Cache，0-9，
#                     按顺序 1297310 依次对应
#                     卡拉赞、格鲁尔的巢穴、玛瑟里顿的巢穴、
#                     毒蛇神殿、风暴要塞、祖阿曼、海加尔山之战、黑暗神殿、太阳井。
#                     零将通用 cache 保持在 Classic 阶梯上。
#        Default:     0

Ascension.PrestigiousCache.TbcStages = 0

#
#    Ascension.CallboardCache.ReleaseStage
#        Description: 服务器当前的内容进度阶段，0-7，按照以下顺序：
#                     Callboard 宝库发布：英雄和史诗地下城、祖尔格拉布、
#                     熔火之心、奥妮克希亚的巢穴、黑翼之巢、安其拉废墟、
#                     安其拉神殿、纳克萨玛斯。一个通用的 Callboard 宝库会解析为
#                     等于或低于该阶段的层级。
#                     同一阶段也会限制经典团队副本：高于该阶段的团队副本将被关闭，
#                     进入时会显示“副本已关闭”，而登录时位于其中的角色
#                     将被移出（0 关闭所有团队副本，2 开启祖尔格拉布和熔火之心）。
#                     游戏管理员仍可进入；其他地图不受影响。
#                     在 .reload config 时应用。
#        Default:     7

Ascension.CallboardCache.ReleaseStage = 7

#
#    Ascension.CallboardCache.PreviousStageOnly
#        说明：将每个通用 Callboard Cache 保持在已发布阶段低一个阶段。
#                     1378050 cache 承诺“装备达到上一个已发布层级”，
#                     无论此设置如何，它自己都会在那里停止。
#        Default:     0

Ascension.CallboardCache.PreviousStageOnly = 0

#
#    Ascension.CallboardCache.ItemLevelAllowance
#        Description: Callboard Cache 可以超过开启者平均装备物品等级多少：
#                     “此 Callboard Cache 根据你的物品等级给予奖励。”
#                     奖励优先在开启者自身等级或以上，
#                     永远不会超过此允许值。
#        Default:     6

Ascension.CallboardCache.ItemLevelAllowance = 6

#
#    Ascension.CallboardCache.CachePoints
#        Description: 支付一个宝库的 Callboard 宝库进度点数。每个 Callboard
#                     任务会从 ascension_callboard_quest_points 中添加其点数；满
#                     进度条会支付在角色达到的最高平均物品等级等于或低于时，已发布的
#                     ascension_callboard_cache_tier 行中最高层级的宝库，
#                     剩余点数会结转。客户端显示每项数额的十分之一：
#                     150 点的进度条显示为 15，25 点的任务显示为 3（向上取整）。
#        Default:     150

Ascension.CallboardCache.CachePoints = 150

#
#    Ascension.CallboardCache.GoldMin
#    Ascension.CallboardCache.GoldMax
#        Description: 当 Callboard 宝库开启时，在物品之外支付的金币，
#                     在这两个数额之间随机。
#        Default:     5, 15

Ascension.CallboardCache.GoldMin = 5
Ascension.CallboardCache.GoldMax = 15

#
#    CoA.DungeonTuning.Enable
#        Description: 允许在 5 人地下城中使用 .mythic damage 和 .mythic health。每个玩家都可以
#                     按百分比提高或降低自己副本中生物造成的伤害和生命值，以试验数值；
#                     每次更改都会记录为一行 TUNING 日志。
#                     用于测试服；在正式服上请关闭。
#        Default:     1

CoA.DungeonTuning.Enable = 1
