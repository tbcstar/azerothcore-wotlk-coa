[worldserver]

################################################################################################################
#    Dynamic.XP
#        说明：按等级段的经验倍率、玩家可以为自己选择的倍率，
#                     以及关于它的提醒。
#
#        Dynamic.XP.Rate.Announce: 1（启用）在登录时告诉每个玩家他们的倍率
#                                  0（禁用）默认 - 全领域提醒已涵盖它
#
#        Dynamic.XP.Preset: 领域倍率，也是每个尚未选择倍率的角色的默认值。
#                           在启动时和 ".reload config" 时读取，因此
#                           手动编辑此行有效。
#                           1（默认）= 无奖励
#                           3 / 5 / 7   = 每个等级使用该固定倍率
#                           0           = 下面的按等级段曲线（需要 Dynamic.XP.Rate = 1）
#
#        Dynamic.XP.Preset.PlayerChoice: 1（默认）允许玩家使用
#                                        ".xp 1|3|5|7|dynamic|default" 更改自己的倍率
#                                        0 = 仅游戏管理员
#
#        Dynamic.XP.Rate: 1（启用）默认 - 控制按等级段曲线（预设 0）
#                         0（禁用）
#
#        Dynamic.XP.Rate.X-X: 1+（在该等级范围设置自定义经验倍率）
#                             0 （将该等级范围的自定义经验倍率重置为默认值）
#
#        Dynamic.XP.Reminder.*: 关于 ".xp" 的全领域提示。间隔以分钟为单位，
#                               0 关闭重复；Message 按原样发送（包括颜色代码
#                               和所有内容）。它在玩家登录时公告，然后
#                               每隔 Interval 分钟向未禁用
#                               自动公告的玩家公告。
#

Dynamic.XP.Rate.Announce = 0

Dynamic.XP.Preset = 1

Dynamic.XP.Preset.PlayerChoice = 1

Dynamic.XP.Rate = 1

Dynamic.XP.Rate.1-9 = 1
Dynamic.XP.Rate.10-19 = 2
Dynamic.XP.Rate.20-29 = 3
Dynamic.XP.Rate.30-39 = 4
Dynamic.XP.Rate.40-49 = 5
Dynamic.XP.Rate.50-59 = 6
Dynamic.XP.Rate.60-69 = 7
Dynamic.XP.Rate.70-79 = 8

Dynamic.XP.Reminder.Enable = 1

Dynamic.XP.Reminder.Interval = 40

Dynamic.XP.Reminder.Message = |cff4CFF00XP rate|r: pick your own with |cff4CFF00.xp 1|r, |cff4CFF00.xp 3|r, |cff4CFF00.xp 5|r or |cff4CFF00.xp 7|r, or |cff4CFF00.xp default|r to follow the realm. |cff4CFF00.xp|r shows what you are on.

##################################################################################################################
