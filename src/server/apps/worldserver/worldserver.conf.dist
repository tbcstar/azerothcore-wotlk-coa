###################################################################################################
# CLUSTER SETTINGS-集群设置
#
# 此功能是实验性的，仍在开发中。它启用集群模式，允许单个领域运行多个
# worldserver，在它们之间分配负载。除了 worldserver 之外，
# 还需要额外服务才能正常运行。如果遇到任何问题，请报告
# 给 ToCloud9 项目：https://github.com/walkline/ToCloud9
#
#    Cluster.Enabled
#        说明：启用/禁用集群模式。
#                     安全：在集群模式中，ToCloud9 网关是受信任的
#                     认证边界。此 worldserver 随后跳过会话密钥
#                     摘要验证、数据包加密、warden、IP/国家锁定、
#                     封禁和最低安全级别强制执行，以及
#                     登录时的角色所有权检查。worldserver 端口必须
#                     只能由网关访问，绝不能直接由玩家访问。
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Cluster.Enabled=0

#
#    Cluster.AvailableMaps
#        Description: 此服务器上可用地图 ID 的列表。
#        Examples:    "" - (Can handle any map)
#                     "0,1,573"

Cluster.AvailableMaps=""

#
#    Cluster.IsCrossrealm
#        说明：为跨领域设置启用跨领域功能。
#                     启用后，需要连接到 MySQL 跨领域反向代理
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Cluster.IsCrossrealm=0

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# CLUSTER SETTINGS END-集群设置结束                                                               #
#                                                                                                 #
###################################################################################################
