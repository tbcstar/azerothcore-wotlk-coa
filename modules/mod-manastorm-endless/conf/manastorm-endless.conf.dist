[worldserver]

# 启用/禁用法力风暴玩法模块（需要重启）。
Manastorm.Enable = 1

# 仅针对常规终局轨道宝箱的每周上限，按角色计算，并在各模式/层级间共享。
# 升级和普通轨道宝箱（包括 60 级）、首通奖励宝箱、
# 宝藏守护者宝箱、货币、箱子、卡牌包和贪婪恶魔奖励不受此限制。
# 使用核心的每周任务重置计划。两个选项均可重载。
Manastorm.WeeklyCacheLockout.Enabled = 1
# 有效范围：0..255；无效值会记录错误并回退到 5。
# 当 Enabled = 1 时，Limit = 0 会阻止所有常规终局宝箱奖励。
Manastorm.WeeklyCacheLockout.Limit = 5

# 自动词缀需要此阶段生物等级，并完成第一个原生词缀解锁深度。
# 个体进度词缀仍然需要其匹配的原生解锁/提示；这些深度保持不变。
Manastorm.AffixMinimumLevel = 50

# 1 = 终局宝箱遵循 coa.conf 中的 Ascension.CallboardCache.ReleaseStage（3 熔火之心 ... 8 纳克萨玛斯）：
# 团本高于当前阶段的宝箱会回退到最高的已发布宝箱，
# 贪婪恶魔的战利品保持在那些已发布宝箱所含的最高物品等级或以下。
# 0 = 无论阶段如何，所有宝箱层级和整个贪婪恶魔池都可用。
# 可重载。
Manastorm.FollowReleaseStage = 0

# 客户端集成模式（需要重启）：
#   1 = 重建的 3.3.5 客户端插件传输（MANASTORM 插件前缀）
#   2 = 原始 Ascension 原生 Manastorm 协议（使用包含的 CoA 原生操作码桥接）
Manastorm.ClientMode = 2

# 匹配原始客户端 Manastorm.dbc，在模式 2 中进行只读身份验证。
# 省略时默认：<DataDir>/dbc/Manastorm.dbc。
# Manastorm.NativeDBCPath = "C:/path/to/matching/Manastorm.dbc"
# 此模块独家拥有 Manastorm 请求和玩法。
# 兼容性捐赠者运行服务从不注册。
# AscensionCompat.Enable / 远程客户端准入仍为核心连接设置。

# 登录 5 秒后以 Lua 推送的客户端 UI 修复（仅模式 2，无需客户端文件）。
# 位掩码，0 = 关闭，原版客户端 UI 保持不变：
#   1 = 队伍查找器快捷键在 Manastorm 副本内也可打开
#   2 = 奖励图标锚定在"潜在奖励"分隔线下方
#   4 = 队列面板处理空的可进入等级列表和未缓存的奖励物品
#   8 = 没有配装法术时隐藏配装弹出菜单
#  15 = 以上全部
# /reload 会将其丢弃，直到下次登录。
Manastorm.ClientUIFixes = 0

# 原生机动性在模式 2 中自动覆盖所有 36 个列出的职业法术系。
# 运行时辅助光环跟随当前混合内容，并在离开你的 Manastorm 阶段后被移除。
# 需要匹配的 <DataDir>/dbc/Spell.dbc。无需客户端文件或 SQL 修改。
