#
# 虚空集市 - 提拉西斯与集市令牌经济
#

[worldserver]

# 完全关闭模块而不删除它。提拉西斯仍留在世界中但
# 停止回应；他的轮换不会运行。
# Default: 1 (enabled)
EtherealBazaar.Enable = 1

# 一次轮换持续多长时间。每次轮换都会抽取一个新的间隔，因此
# 商店不会在玩家可以按表设定时间的时候改变。
# Default: 3 to 6 hours
EtherealBazaar.RotationMinHours = 3
EtherealBazaar.RotationMaxHours = 6

# 每个价格区间为一次轮换贡献多少物品。
#
# 这些是有意不均匀的。池子是不均匀的：大约 3300 件物品低于
# 1000 令牌，440 件在 1000 到 1500 之间，190 件高于此。相等的槽位
# 数量会让一件昂贵物品出现的频率远高于便宜物品，
# 因为它从一个更小的袋子中抽取。使用下面的数字，一件给定的
# 便宜物品大约每 27 天回归一次，中等物品每 36 天，昂贵物品
# 每 48 天，每天四次轮换。
#
# 如果你更改池子，在更改这些之前请再次检查那三个数字。槽位
# 跟随区间的大小，而不是物品应该感觉多稀有。
EtherealBazaar.Slots.Cheap = 30
EtherealBazaar.Slots.Mid = 3
EtherealBazaar.Slots.Expensive = 1

#
# 模块在 "module.bazaar" 下记录日志：池子包含什么、每次
# 轮换抽取了什么，以及下一次何时到期。AzerothCore 只打印
# 已配置的 logger，未配置的会回退到根
# logger，通常只显示错误。要看到任何内容，请将以下内容添加到
# worldserver.conf 中其他 Logger 行旁边：
#
#   Logger.module.bazaar=4,Console Server
#
# 没有它，模块运行完全相同，只是什么都不说。

#
# 集市令牌来自哪里
#
# Ascension 用它们换钱，并让玩家在拍卖
# 行交易它们。商店消失后，唯一剩下的来源就是游玩，因此一点点来自
# 一切，更多来自更难的内容。下面两个范围故意从
# 零开始：大多数击杀什么都不给，这让令牌值得注意。
# Default: 1 (enabled)
EtherealBazaar.Tokens.Enable = 1

EtherealBazaar.Tokens.Quest.Min = 0
EtherealBazaar.Tokens.Quest.Max = 12
EtherealBazaar.Tokens.Creature.Min = 0
EtherealBazaar.Tokens.Creature.Max = 3
EtherealBazaar.Tokens.DungeonBoss.Min = 14
EtherealBazaar.Tokens.DungeonBoss.Max = 22
EtherealBazaar.Tokens.RaidBoss.Min = 41
EtherealBazaar.Tokens.RaidBoss.Max = 53

# 从此等级起，每个数量都会乘以下面的百分比，因此
# 停止升级的角色不会停止赚取。
EtherealBazaar.Tokens.BonusLevel = 60
EtherealBazaar.Tokens.BonusPercent = 150

# 右上角的“收到物品”提示。令牌掉落足够频繁，以至于
# 它变成了噪音；袋子无论如何都会更新。
# Default: 0 (no toast)
EtherealBazaar.Tokens.Announce = 0
