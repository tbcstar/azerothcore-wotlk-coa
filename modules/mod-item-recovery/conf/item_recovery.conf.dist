###################################################################################################
#  mod-item-recovery
#
#  原生商人回购/删除恢复，使用当前回购以及精确的未来快照。
#  存档为每个角色保留最新的 500 个受支持的处置事件。
#  现有的基本 recovery_item 行仍仅限 GM 使用；缺失的原始物品属性
#  绝不会仅凭条目/数量重建。存档的恢复通过邮件送达。
#
#  此代码是 AzerothCore 项目的一部分。版权信息请参见 AUTHORS 文件。
###################################################################################################

[worldserver]

#    ItemRecovery.Enable
#        Description: 是否向玩家提供并响应物品恢复窗口。
#        Default:     1 - (Enabled)
#                     0 - (Disabled; 客户端保持窗口隐藏)
ItemRecovery.Enable = 1

#    ItemRecovery.Archive.Enable
#        描述：捕获受支持的未来已删除/已出售物品及其原生物品字段。
#                     需要待处理的精确物品恢复角色迁移。
#                     不会启用分解、回收、角色恢复或退款功能。
#        默认值：     1 - 当 ItemRecovery.Enable 启用时启用。
ItemRecovery.Archive.Enable = 1

#    ItemRecovery.Characters.Enable
#        描述：免费恢复该账号下保留的软删除角色。
#                     现有的名称以及账号/服务器角色数量限制仍然适用。
#                     CharDelete.Method = 1 会保留未来的删除；已清除的角色无法恢复。
#        默认值：     1 - 在 ItemRecovery.Enable 下启用。
ItemRecovery.Characters.Enable = 1

#    ItemRecovery.Worldforged.Enable
#        描述：应答原生的、限时的世界锻造物品/符文兑换提议。
#                     需要两个待处理的 recovery_worldforged 迁移以及编写好的提议数据行。
#                     仅当有有效提议激活时，客户端类别才会启用。
#                     支持背包中已保存、未装备、未修改的武器/护甲实例。
#                     附魔、随机属性、已使用充能和已穿戴物品不会被丢弃。
#                     不会虚构退款活动或通用资格期。
#        默认值：     0 - 在安装经过审核的提议数据之前禁用。
ItemRecovery.Worldforged.Enable = 0
