#
#    Rate.XP.Kill
#    Rate.XP.Kill.TBC
#    Rate.XP.Kill.WotLK
#    Rate.XP.Elite
#    Rate.XP.DungeonElite
#    Rate.XP.Quest
#    Rate.XP.Quest.TBC
#    Rate.XP.Quest.WotLK
#    Rate.XP.Explore
#    Rate.XP.Pet
#        说明：经验倍率（战场外）。默认值是 PR #4128 中捕获的
#                     Ascension Conquest of Azeroth 领域实时倍率。
#                     击杀倍率按地图和区域内容应用（Kill = 1-60 级内容），
#                     任务倍率按任务等级应用（Quest = 1-60 级任务）。
#                     Rate.XP.Elite 和 Rate.XP.DungeonElite 分别替换固定的 x2 精英击杀奖励，
#                     分别在副本和团队副本外和内部。
#        Default:     1.0909091 - (Rate.XP.Kill)
#                     1.0909091 - (Rate.XP.Kill.TBC)
#                     0.90909094 - (Rate.XP.Kill.WotLK)
#                     1.44     - (Rate.XP.Elite)
#                     2.175    - (Rate.XP.DungeonElite)
#                     1.26     - (Rate.XP.Quest)
#                     1.26     - (Rate.XP.Quest.TBC)
#                     1.05     - (Rate.XP.Quest.WotLK)
#                     1        - (Rate.XP.Quest.DF) - 仅地下城查找器/LFG 任务。
#                     4        - (Rate.XP.Explore)
#                     1        - (Rate.XP.Pet)

#    Rate.XP.Global
#        在模块修改器之前，使用 OnPlayerGiveXP 乘以所有玩家经验来源，包括动态经验。
#        默认 0.9295，PR #4128 中捕获的领域倍率。
Rate.XP.Global = 0.9295

#    Rate.XP.Profession
#        临时本地公式，未验证与实时 Ascension 经验一致：
#        floor(当前等级所需经验 * BaseFraction * Profession * 技能修正 * 难度)。
#        然后应用全局和 XP 模块修改器，接着是正常的 GiveXP 限制/奖励。
#        每次完成采集/制造动作时授予，独立于技能提升判定。
#        钓鱼使用区域技能阈值；垃圾捕获不授予。灰色默认为零。
#        采集节点使用核心的每玩家每重生一次的技能尝试守卫。
#        技能/难度默认值来自 PR #4128；BaseFraction 是本地策略（1/50 等级）。
#        将 Profession 设置为 0 以禁用普通专业奖励。所有倍率随 .reload config 重新加载。
#        仅专业挑战保留其单独的每次技能提升公式和队伍共享；
#        这些奖励也使用全局和动态经验。伐木/木工在此没有核心动作路径
Rate.XP.Profession = 0.4
Rate.XP.Profession.BaseFraction = 0.02
Rate.XP.Profession.Gray = 0
Rate.XP.Profession.Green = 0.95
Rate.XP.Profession.Yellow = 1
Rate.XP.Profession.Orange = 1.05
Rate.XP.Profession.Mining = 2.11
Rate.XP.Profession.Herbalism = 1.44
Rate.XP.Profession.Disenchanting = 1.44
Rate.XP.Profession.Skinning = 0.55
Rate.XP.Profession.Fishing = 0.33
Rate.XP.Profession.Blacksmithing = 3.77
Rate.XP.Profession.Jewelcrafting = 3.77
Rate.XP.Profession.Alchemy = 3
Rate.XP.Profession.Enchanting = 2.88
Rate.XP.Profession.Leatherworking = 2
Rate.XP.Profession.FirstAid = 0.55
Rate.XP.Profession.Cooking = 0.55
Rate.XP.Profession.Engineering = 3.6
Rate.XP.Profession.Tailoring = 1.66
Rate.XP.Profession.Lockpicking = 0
Rate.XP.Profession.Inscription = 2.88

Rate.XP.Kill            = 1.0909091
