#
# CoA：Ascension 客户端兼容性
#

[worldserver]

# 启用兼容性数据包过滤器。
CoA.Enable = 1

# 按下一次 /s .rotation 会尝试对选中的目标施放一个已学会的攻击或治疗技能。
# 使用 CoA 专精优先级，并为其他构筑提供基础回退逻辑。
CoA.RotationAssist.Enable = 1

# 制造物品升级的最大步数：0 禁用升级套件，1 允许精制，
# 2 允许精良，3 允许大师级。默认：2。数值会被限制在 0-3。
# 在启动和配置重载时生效；已升级的物品保持不变。
# 衬衣、背包/箭袋、奥术扳手以及被排除的歧义物品系列无法升级。
CoA.Crafting.MaxUpgradeSteps = 2

# 将 Ascension 协议设置应用于远程连接以及回环连接
# （扩展操作码、ping 间隔、法术修饰符布局、职业 10 映射）。
# 仅在专用于匹配 Ascension 客户端版本的服务器上启用。
# 身份验证证明和数据包大小检查仍然必需。重启以应用。
CoA.AllowRemoteClients = 1

# Ascension 的无职业角色创建器提交职业 ID 10（英雄）
# 1 - 改为创建一个原版战士空壳。
# 0 - 创建一个英雄。在 CoA.ClassModel = "hero" 的服务器上使用此项。
CoA.MapClass10ToWarrior = 1

# 客户端实验室探测中继：管理员命令 .labprobe 以插件消息形式向一个
# 在线实验室角色密语发送只读的 CoaProbe 请求，并收集插件密语返回的分块答案。
# 仅接受名称以 CoA.ProbeRelay.AccountPrefix 开头的账户（不区分大小写）。
# 仅在实验室服务器上启用。默认值：0。
CoA.ProbeRelay.Enable = 0
CoA.ProbeRelay.AccountPrefix = "COALAB"

# 在协议发现期间记录每个被消费的扩展数据包。
CoA.LogConsumedPackets = 1

# 来自精英战争宝箱（2977351）的服务器绑定集市代币。
# 其中持有的 1500 个集市代币（975001）被视为每账号储备：
# 购买时优先使用该储备，且仅当账号至少保留该储备时，代币才能被交易、邮寄给另一个账号、拍卖或存入公会银行。
# 账号自身角色之间的邮件免费。超过储备的刷取代币仍可交易。
CoA.BazaarTokens.WarchestRealmBound = 1

# Ascension 角色选择界面：启用/禁用（激活/停用）以及
# 按账号的角色列表排序顺序。
# Requests: CMSG 0x072E / 0x072F / 0x0772.
# Responses: SMSG 0x075E / 0x075F / 0x0760 / 0x076F / 0x0770 / 0x0771.
CoA.CharacterSelectionEnable = 1

# 每个账号同时激活的最大角色数量（1-128）。
# 已停用的角色仍会被保存，并从标准角色列表中隐藏，
# 之后可以重新激活。
CoA.CharacterSelectionMaxActive = 128

# 自动为角色获得的物品添加外观和装饰条目。
CoA.AutoCollectAppearances = 1

# 在获得奖励的击杀中，最多掉落一件与敌人可见装备相匹配的可穿戴物品。
# 使用 NPC 显示预设或 CreatureDisplayInfoExtra，外加当前武器/盾牌条目。
# 只有未绑定/装备后绑定、品质不高于优秀、且等级不高于敌人等级的装备才符合条件。
# 属性优先选择施法者智力、防御者的防御/耐力，或物理力量/敏捷。
# 每次击杀的百分比是本地重建的默认值；原始概率未被记录。
CoA.EquippedGearLoot = 1
CoA.EquippedGearLootChance = 5

# 普通难度生物的生命值和伤害倍率，已根据 Ascension 正式服读数进行调整。
# 生命值在生物确定等级时相乘；伤害作用于对玩家及其宠物的命中。
# 英雄/史诗、战场、竞技场、宠物、召唤物、图腾、触发器、小动物和训练假人
# 不会改变；coa_boss_flex 中列出的团队副本生物保留其测得的弹性生命值。
# MapHealth/MapDamage 按地图以 "mapId:multiplier" 形式替换上下文值。
# 每个值也可以是生物等级的公式：数字、level、+ - * /、括号、min(a, b) 和
# max(a, b)，例如 CoA.CreatureScaling.World.Health = "1.17 + 0.013 * level"。在 MapHealth/MapDamage 中编写公式
# 时不要带空格（"43:0.3+0.08*level"），或用 ';' 分隔条目（"43: 0.3 + 0.08 * level; 36: 2.2"）。
# 世界生命值根据 Ascension 正式服视频中看到的开放世界生物生命值拟合（1-59 级）。世界
# 近战伤害是对一只 1 级夜行蝙蝠攻击一名新 1 级角色
# （72 护甲）造成 5-8 伤害的正式服视频拟合基础值的一半（"4.32 + 0.013 * level"），与现在的正式服 PTR 一致。地下城和团队副本保留其早先的估算值。
# 如果没有此部分，服务器会保留这些倍率，但会使该功能保持禁用。
CoA.CreatureScaling.Enable = 1
CoA.CreatureScaling.World.Health = "1.17 + 0.013 * level"
CoA.CreatureScaling.Dungeon.Health = 2.5
CoA.CreatureScaling.Raid.Health = 2.2
CoA.CreatureScaling.MapHealth = "36:2.2 43:2.0 229:4.0 389:3.0 469:5.0"
CoA.CreatureScaling.World.Damage = "2.16 + 0.013 * level"
CoA.CreatureScaling.Dungeon.Damage = 1.5
CoA.CreatureScaling.Raid.Damage = 1.0
CoA.CreatureScaling.MapDamage = ""
# 近战伤害浮动：生物最高普通命中与最低普通命中的比值，围绕相同平均值（正式服开放世界
# 普通生物根据玩家战斗日志为 1.5-1.6；1 级时更宽，同一夜行蝙蝠视频中为 5-8）。
# 0 保留默认范围。公式和 MapDamageSpread 同上。
CoA.CreatureScaling.World.DamageSpread = "max(1.55, 1.85 - 0.05 * level)"
CoA.CreatureScaling.Dungeon.DamageSpread = 0
CoA.CreatureScaling.Raid.DamageSpread = 0
CoA.CreatureScaling.MapDamageSpread = ""
# 生物的法术和周期性伤害。上述伤害涵盖近战挥击和近战/远程法术（武器打击、
# 流血）；其他所有开放世界法术则改用 World.SpellDamage。根据玩家战斗日志，正式服生物法术
# 在生物自身等级下的伤害大约等于其法术数据值，因此默认不缩放。地下城和团队副本
# 没有自己的法术系数：除非 MapSpellDamage 指定了地图，否则它们的法术保持 Dungeon.Damage/Raid.Damage。
# 公式和 MapSpellDamage 同上。
CoA.CreatureScaling.World.SpellDamage = 1
CoA.CreatureScaling.MapSpellDamage = ""

# 非玩家控制的 NPC 使用类似原版的魔法抗性，包括神圣系
# （docs/coa/monster-linear-resistance.md）。每一点战斗等级为所有魔法学派增加 PerLevel 抗性；
# 穿透和减益效果会将其降低至至少 0。每一点 PerPercent 抗性增加 1% 平均抵抗率，上限由
# MaxReductionPct 限制。直接命中和持续伤害跳数围绕该平均值按原生 10% 部分抵抗阶梯判定；伤害
# 法术永远不会被完全抵抗，控制效果可以被完全抵抗。玩家、宠物和被魅惑的生物保持原生规则。
# PerPercent 是重建时选择的数值，并非已验证的线上值。
# 1 - enabled (default).
# 0 - 原生抗性，包括隐藏的等级差项和 Classic+ 抵抗表。
CoA.MonsterResistance.Enable = 1
CoA.MonsterResistance.PerLevel = 1.0
CoA.MonsterResistance.PerPercent = 5.0
CoA.MonsterResistance.MaxReductionPct = 75.0

# 为机器人操控的角色启用衣柜、套装、外观和坐骑/伙伴收藏。
# 0 - 从不：机器人会话跳过收藏（默认）。
# 1 - 仅限玩家账号中被作为机器人操控的角色（小号），绝不包含随机机器人账号：
#     其保存的套装和外观会像玩家一样被应用。
# 2 - 所有机器人会话。
# 随机机器人账号通过名称前缀 CoA.RandomBotAccountPrefix 识别，该前缀必须
# 与 mod-playerbots 的 AiPlayerbot.RandomBotAccountPrefix 匹配（默认：rndbot）。
CoA.CollectionsForBots = 0
CoA.RandomBotAccountPrefix = "rndbot"

# 单人服务器便利：解锁完整的本地外观目录。
# 每个类别的值用于平衡初始快照；剩余的幻化外观随后以流式传输，
# 以保持在旧版客户端 64 KiB 数据包限制之下。
CoA.UnlockLocalAppearanceCatalog = 0
CoA.AppearanceCatalogPerCategory = 500

# 单人服务器便利：将每个静态 VanityCollection 条目公开为账户所有。
# 仅限 Ascension 的自定义条目仍然需要匹配的服务器物品/法术模板才能交付。
CoA.UnlockAllVanity = 0

# 每个账号首次登录时即拥有的收藏品道具，以空格分隔的物品 ID 表示。
# 它们会记录在账号的收藏中，因此即使 CoA.UnlockAllVanity = 0 也仍保持已拥有状态，
# 且CoA.LearnOwnedCompanions 会教授其对应的坐骑/伙伴法术。
# 客户端VanityCollection.dbc 中缺失的 ID 以及消耗品条目会被跳过。
# 示例："98457 134987"（飞升之书和工匠之书）。
# Default: ""
CoA.StarterVanityItems = ""

# 如果某个收藏品道具没有服务器物品模板，但其 DBC 行指定了有效法术，
# 则在请求发放时直接学习该法术。
CoA.AllowLearnedSpellDelivery = 1

# 永久教授已拥有的装饰坐骑/伙伴法术，以小的登录批次进行。
# 所有权保持不变。没有本地法术的条目不会被虚构。
CoA.LearnOwnedCompanions = 1

# 单人服务器便利：从首次登录起所有骑术等级（300/300）和寒冷天气飞行，
# 包括一级角色。不授予专业。
CoA.MaxRidingFromStart = 0

# 坐骑飞行规则。
# 0 - 玩家在达到专家骑术或更高等级时可以在外域飞行；在诺森德，学会寒冷天气飞行后可以飞行；
#     在艾泽拉斯、战场、战地和禁飞区域永远不能飞行。所有坐骑都遵循此规则，
#     包括 Ascension 自有的坐骑（如 Ash'adar）；
#     离开飞行区域的骑手会被自动下马。
# 1 - 沿用 PR #8631 之前的飞行规则：上述规则仅适用于法术书中的坐骑，
#     Ash'adar 永远不能飞行，其他坐骑在其自身法术允许的地方飞行，
#     离开飞行区域时不会被下马。
# 启动时和配置重载时生效。
# Default: 0
CoA.LegacyMountFlight = 0

# 在登录时，为不携带三种 PvP 规则集光环中任何一种的角色授予 PvE 规则集，
# 因为角色创建时不会授予规则集，且客户端的选择界面受等级和休息区域限制。
# PvE 规则集就是单独的 PvE 模式光环 9931032，
# 与点击“PvE 模式”所应用的效果完全一致。与此设置无关，
# 携带 PvE 模式旁边 War Mode 光环 1004119 的角色在登录时会失去 War Mode 光环。
# 设为 0 可将此类角色保留在 Ruleset.None 上。
CoA.RulesetLoginDefault = 1

# 战争模式（1004119，不含 PvE 模式）和高风险（1004019）在开放世界中保留生物、宝箱和任务等级
# 缩放，与 Ascension 上一致。设为 1 可在开放世界中为这两套规则关闭等级缩放。
# 副本则保留角色自身的选择。
CoA.Ruleset.DisableLevelScaling = 0

# GatherMate 采集区域（池 20000000-20099999）会保持其一部分刷新点处于激活状态，比例随
# 该区域内的玩家数量变化：无人时为 MinFraction，加上每名玩家的 PerPlayerFraction，最高不超过
# MaxFraction。每当节点重生时都会读取该限制，因此随着节点被采集，区域会逐渐填满或变少；
# 不会删除任何内容。将 ScaleWithZonePlayers 设为 0 可使用 pool_template 的 max_limit 代替。
CoA.GatherNodes.ScaleWithZonePlayers = 1
CoA.GatherNodes.MinFraction = 0.10
CoA.GatherNodes.PerPlayerFraction = 0.015
CoA.GatherNodes.MaxFraction = 0.35

# 在客户端 QuestTemplateScaling.dbc 中拥有对应行的任务会跟随角色：
# 该行中等于或低于角色等级的最高点将任务设为该等级加上其偏移量（内置行跟随 4 到 1 级），
# 并保持在行的最小和最大等级内，且从不低于任务自身等级。
# 经验按该等级计价，金钱按其层级在该等级与任务自身等级之间的比例计算。
# 没有对应行的任务保留其原有等级。
CoA.QuestLevelScaling = 1

# 使用客户端的缩放标志 (0x01000000) 在任务的曲线上标记它，这将其着色为“标准”
# 而不是按等级。实时任务缓存从未携带该标志。
CoA.QuestLevelScaling.ClientFlag = 0

# 由等级缩放生物掉落的武器和护甲，由选择了
# 等级缩放的角色在宝箱中找到的，或由等级缩放任务给予的，会被提升到该内容的等级，向下取整
# 到五级一档，作为条目从 4400001 起的副本。衬衣、战袍和没有
# 物品等级的物品保持原样。
# 设为 0 以停止新的提升；已经发放的副本继续有效。当原生物品缩放
# (CoA.ItemScaling.Native) 处于激活状态时，也不会制作新的副本。
CoA.ItemScaling = 1

# 客户端 ItemStat.dbc 中带有等级阶梯的武器和护甲保留自己的条目，并
# 获得一个缩放等级而不是副本：拾取者等级加上 LootLevelOffset，范围 1 到 65，在
# 物品被拾取、掷骰赢得，或在启用 QuestRewards 时由任务给予时设置一次。在
# DestinyWeaver.Scaling.DungeonIds 列出的地下城内，战利品会对所有人缩放，可升可降，调整到
# 拾取者的等级。它们的属性来自该等级对应的阶梯行，客户端使用操作码 0x6FF 请求同一行。
# 世界锻造物品以及复制路径从未提升的物品保持原样。当其激活时，复制
# 路径（CoA.ItemScaling）完全不会创建新副本；已经发放的副本继续有效。
# 仅在启动时读取。设为 0 时，物品保留其原始属性，复制路径再次处理它们。
CoA.ItemScaling.Native = 1
CoA.ItemScaling.Native.LootLevelOffset = 0
CoA.ItemScaling.Native.QuestRewards = 1

# RebornArmor 会为除无职业英雄以外的每个职业提供客户端显示给他们的重生护甲：
# 对于缩放物品，使用等级阶梯行中的第二护甲列；对于自定义物品，使用 ItemAddon.dbc 中的
# 重生护甲（没有该值的物品保留其自身护甲）。属性回复随后会同时携带这两列。设为 0 时，
# 物品对所有人提供其完整护甲，回复中也重复该值。需要 Native；仅在启动时读取。
CoA.ItemScaling.Native.RebornArmor = 1

# 自动进度：当角色升级时，根据其职业和等级发放职业能力和等级升级。
# 设为0以停止该功能，改为让玩家自行请求——飞升之书会授予它们，
# 因此希望以书籍作为获取能力方式的服务器会关闭此项。
# 天赋树的免费节点无论如何
# 都会授予：书籍不出售它们。可重新加载。
CoA.AutoProgression = 0

# 流式传输已安装的 Ascension 客户端无法从其自身文件中解析的 CreatureDisplayInfo 补丁行
# （自定义显示 ID）。该流在客户端扩展握手之后开始，
# 如果始终未到达，则有一个简短的登录回退。
CoA.SendDisplayPatches = 1

# 客户端 CreatureDisplayInfo.dbc 的未打补丁副本，用于精确流式传输客户端缺失的行。
# 留空则选择 DataDir/dbc_clientset；当该副本不可用时，使用服务器自身的
# DataDir/dbc/CreatureDisplayInfo.dbc，因此只流式传输通过
# creaturedisplayinfo_dbc 添加的行。
CoA.ClientDbcDirectory = ""

# 从已安装客户端的操作码分发表中导出的扩展范围。
# 请保持这些值为十进制，因为 ConfigMgr 数值会按十进制解析。
CoA.FirstExtensionOpcode = 1311
CoA.LastExtensionOpcode = 2515

# 实验性本地 Manastorm。需要匹配的角色迁移和客户端 UI 补丁。
# 仅启动时：单人等级 10-59，三个场景，深度 1-15。领域等级上限不变。
# 仅在经过审查的安装包中启用；仍然需要原生游戏验收。
Ascension.Manastorm.Enable = 0

# 客户端被告知它所在的服务器类型：可以是 live (正式服)、seasonal (赛季服) 、league(联赛)、ptr（公共测试服）
# 和development 中的一个或多个，用空格分隔。发送的每种类型都会打开客户端中
# 标记为该类型的行，因此 "live seasonal" 会同时显示两者的角色成长条目，
# 就像在正式基础设施上的赛季服务器一样。
# 空值或未知值会发送 live。
#
# 这不是装饰性的。
# 客户端仅从匹配活动领域类型的行构建其装饰目录，
# 因此如果没有设置，无论账户拥有什么，装饰收藏都会保持为空。
# Default: live
CoA.RealmType = "live"

#
#    CoA.ClassModel
#        说明：在请求角色列表时，通过 SMSG_REALM_INFO 向客户端通告的
#                     角色创建模式。
#                     "coa"  - Conquest of Azeroth 职业。默认。
#                     "wcr"  - Warcraft Reborn（经典）职业。
#                     "hero" - 自由选择英雄。
#        Default:     "coa"
#

CoA.ClassModel = "coa"

# 在本服务器启用法术 86000 的被动 15% 未骑乘奔跑速度光环。
# 更强的普通奔跑速度光环会替换其加成；它们不会与之叠加。
# 骑乘、游泳和飞行速度不变。需要重启 worldserver。
# 在 52 区选择启用；在其他服务器保持禁用以保留其原有行为。
Ascension.RunSpeedAura.Enable = 0

#
#    CoA.GameModeMask
#        Description: 角色登录时发送给客户端的自定义游戏模式位，用于开启对应的客户端 UI 和规则。
#                     添加数值可以组合多个模式。
#                     2    - 铁人
#                     4    - 生存专家
#                     8    - 轮抽
#                     32   - 坚定
#                     64   - 外卡
#                     128  - 邪能锻造
#                     256  - 梦魇
#                     2048 - 构筑轮抽
#                     4096 - 十字军
#        默认值：     0 - 无自定义游戏模式
#

CoA.GameModeMask = 0

#
#    CoA.ClientBooleanConfigs
#    CoA.ClientIntegerConfigs
#        Description: 通过 SMSG_COA_CONFIG 发送的额外客户端配置，格式为逗号分隔的 NAME=value list.
#                     它们用于选择服务器特定的客户端 UI，例如
#                     "CONFIG_LEGACY_CHARACTER_ADVANCEMENT_ENABLED=0" 会在自由选择服务器上
#                     加载当前的角色进阶界面，而不是第 9 赛季的界面。
#        Default:     "" - none
#

CoA.ClientBooleanConfigs = ""
CoA.ClientIntegerConfigs = ""

###################################################################################################
# HIGH-RISK PACKAGE-高风险包
#
#    HighRisk.Losses
#        说明：在高风险规则集（光环 1004019）下，开放世界中的死亡会将
#                     可交易装备、背包资源和金币移入一个持久宝箱，附近任何
#                     存活的高风险玩家都可以取回。击杀经验不变：规则集
#                     光环已经携带原生奖励。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.Losses = 1

#    HighRisk.GearChance
#    HighRisk.ResourceChance
#    HighRisk.GoldChance
#        说明：每次符合条件的死亡，每个类别丢失的百分比几率。领域调整，
#                     不是已验证的 Ascension 速率。如果所有掷骰都未命中，仍然会
#                     选择一个可用类别，因此符合条件的死亡永远不会静默地不产生宝箱。
#        Default:     50

HighRisk.GearChance = 50
HighRisk.ResourceChance = 50
HighRisk.GoldChance = 50

###################################################################################################
# RATED SOLO ARENA-单排竞技场
#
#    RatedSoloArena.RoleBalanceWaitSeconds
#        Description: 最旧的评级单排队列条目在匹配可以忽略治疗平衡
#                     （每边一个治疗或没有）之前等待的秒数。平衡的阵容仍然优先。
#        Default:     60
#                     0 - （从不放宽治疗平衡）

RatedSoloArena.RoleBalanceWaitSeconds = 60

#    RatedSoloArena.RoleBalance.2v2
#    RatedSoloArena.RoleBalance.3v3
#        Description: 该 bracket 的评级单排阵容是否在RatedSoloArena.RoleBalanceWaitSeconds 
#                     过去之前需要治疗平衡。禁用时，任何分配从一开始就被接受，
#                     并且当存在角色平衡的分配时仍然优先。
#        Default:     0 - (2v2：允许双倍伤害阵容)
#                     1 - (3v3：需要治疗平衡)

RatedSoloArena.RoleBalance.2v2 = 0
RatedSoloArena.RoleBalance.3v3 = 1

#    RatedSoloArena.Win.ArenaPoints.1v1
#    RatedSoloArena.Win.ArenaPoints.2v2
#    RatedSoloArena.Win.ArenaPoints.3v3
#        Description: 按分组授予评级单排或组队比赛每位获胜者的竞技场点数。
#        Default:     25 (1v1), 300 (2v2), 300 (3v3)

RatedSoloArena.Win.ArenaPoints.1v1 = 25
RatedSoloArena.Win.ArenaPoints.2v2 = 300
RatedSoloArena.Win.ArenaPoints.3v3 = 300

#    RatedSoloArena.Win.RunesOfAscension
#        Description: 授予评级单排或组队比赛每位获胜者的飞升符文（物品 375250）。
#        Default:     25

RatedSoloArena.Win.RunesOfAscension = 25

#    RatedSoloArena.SeasonCap.PerWeek
#        Description: 当前竞技场赛季期间，
#                     通过评级单排竞技场胜利获得的竞技场点数的征服点数上限。
#                     该上限自赛季开始以来在每次每周重置时增加此数量（第1周 = 一步）。
#        Default:     12000

RatedSoloArena.SeasonCap.PerWeek = 12000

#    RatedSoloArena.SeasonCap.Max
#        Description: 赛季征服上限的最高值。
#        Default:     0 - (No limit)

RatedSoloArena.SeasonCap.Max = 0

#    RatedSoloArena.Tier.Combatant
#        Description: 在 PvP 框架中显示为竞争者等级的个人等级。竞争者没有头衔。
#        Default:     1400

RatedSoloArena.Tier.Combatant = 1400

#    RatedSoloArena.Title.Challenger
#    RatedSoloArena.Title.Rival
#    RatedSoloArena.Title.Duelist
#    RatedSoloArena.Title.Gladiator
#        Description: 评级单排分组中的个人等级，在首次达到时授予对应的角色头衔
#                     头衔永不会被移除。
#        Default:     1700（挑战者），2000（竞争者），2300（决斗者），2600（角斗士）

RatedSoloArena.Title.Challenger = 1700
RatedSoloArena.Title.Rival = 2000
RatedSoloArena.Title.Duelist = 2300
RatedSoloArena.Title.Gladiator = 2600

#    HighRisk.FelCommutation.Enable
#        Description: 邪能置换。高风险角色开启此功能后，在邪能置换传送门（物件 8000053）的窗口中
#                     选择要投保的装备栏位。开启期间，若角色携带的金币足以支付所有费用，
#                     因高风险死亡而本会掉落的投保栏位物品将被保留，费用则存入死亡宝箱。
#                     若金币不足，角色保留金币，物品照常掉落。正常的金币损失
#                     （HighRisk.GoldChance）仍会在此基础上生效，
#                     从扣除费用后剩余的金币中计算；
#                     死亡消息会分别显示这两部分。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.Enable = 1

#    HighRisk.FelCommutation.FeeMultiplier
#        Description: 应用于每件物品费用的倍数。物品的基础费用为其物品等级乘以
#                     该等级对应的客户端费率区间（例如 179 x 2750 铜币）。
#        Default:     1.0

HighRisk.FelCommutation.FeeMultiplier = 1.0

#    HighRisk.FelCommutation.MaxSlots
#        Description: 一个角色一次可投保的装备栏位数量。0 表示无限制。
#        Default:     3

HighRisk.FelCommutation.MaxSlots = 3

#    HighRisk.FelCommutation.AltarRange
#        Description: 传送门必须处于多少码范围内，才会接受该开关。
#        Default:     20

HighRisk.FelCommutation.AltarRange = 20

#    HighRisk.FelCommutation.ToggleAnywhere
#        Description: 允许在附近没有传送门时接受该开关（例如通过同伴）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.ToggleAnywhere = 0

#    HighRisk.FelCommutation.ClickToggle
#        Description: 在邪能置换窗口中显示一个激活/停用按钮，用于为所有已装备的装备切换邪能置换状态。
#                     使用传送门只会打开或关闭该窗口。原版客户端在使用传送门时
#                     仍会自行发送该开关（其 Extensions.dll 会触发
#                     GAMEOBJECT_USED，其 Lua 会发送开关数据包）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.ClickToggle = 0

#    PvpPower.Enable
#        描述：已装备物品上的 PvP 强度（取 ItemAddon.dbc 中的值，否则取物品的“PvP 强度
#                     (+N)”法术）在 60 级时缩放伤害和治疗，上限为 495 点。对玩家（以及在开放世界中
#                     对高风险攻击者而言，对不受控制的生物）每点伤害 +0.05%；在那里受到的
#                     生物伤害每点 -0.05%；在战争模式、
#                     高风险开放世界和战场中，治疗和护盾每点 +0.02%。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PvpPower.Enable = 1

#    PvePower.Enable
#        描述：已装备物品上的 PvE 强度（取 ItemAddon.dbc 中的值，否则取物品的“PvE 强度
#                     (+N)”法术）在 60 级时缩放伤害和治疗，上限为 495 点。在所有地图上，
#                     对生物造成的伤害每点 +0.05%，受到的生物伤害每点 -0.05%；在
#                     地下城和团队副本中，治疗和护盾每点 +0.02%。与 PvP 强度叠加。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PvePower.Enable = 1

#    Bloodforged.Enable
#        描述：将血铸装备加入符合条件的高风险玩家（15 级起）开放世界
#                     生物尸体的原生拾取掷骰中，物品从 coa_bloodforged_catalogue 中
#                     经过审核的目录抽取。物品池和掉率区间跟随
#                     玩家等级；对玩家显示为灰名的生物不产生掷骰。掉落遵循
#                     标准尸体物品上限，并受 Rate.Drop.Item.Uncommon、.Rare 和
#                     .Epic 缩放。需要 PvpPower.Enable。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Bloodforged.Enable = 1

#    Bloodforged.Rates15
#    Bloodforged.Rates25
#    Bloodforged.Rates35
#    Bloodforged.Rates45
#    Bloodforged.Rates55
#        描述：从该等级开始的等级段内，每个符合条件尸体的基础百分比，以
#                     三个值表示： uncommon、rare、epic。每种品质各掷骰一次，均匀分布
#                     在该品质的物品池中，且在 Rate.Drop.Item.* 乘数之前生效。
#        Default:     "4.50 0.50 0.00", "4.00 1.00 0.00", "3.80 1.40 0.15", "3.60 1.80 0.25", "3.40 2.20 0.40"

Bloodforged.Rates15 = "4.50 0.50 0.00"
Bloodforged.Rates25 = "4.00 1.00 0.00"
Bloodforged.Rates35 = "3.80 1.40 0.15"
Bloodforged.Rates45 = "3.60 1.80 0.25"
Bloodforged.Rates55 = "3.40 2.20 0.40"

#
#    Ascension.PrestigiousCache.ReleaseStage
#        说明：领域已发布的最新层级，1-6。一个 Prestigious Cache 只支付
#                     其自身内容的令牌，并且永远不会支付高于此层级的令牌，
#                     因此 Classic 阶段的领域永远不会发放 Tier 6 令牌。
#                     Tier2.5 计为 2.5，所以 3 仍然覆盖它。
#        Default:     6

Ascension.PrestigiousCache.ReleaseStage = 6

#
#    Ascension.PrestigiousCache.TokenChancePercent
#        Description: Prestigious Cache 同时交出自身层级令牌的几率，
#                     正如该 cache 自己的描述所说，
#                     “如果层级已发布，有机会获得一个或多个全局层级令牌”。
#                     内容没有自己令牌的 cache 不支付任何令牌。
#        Default:     25

Ascension.PrestigiousCache.TokenChancePercent = 25

#
#    Ascension.PrestigiousCache.SecondTokenChancePercent
#        Description: 第一个令牌变为两个的几率。
#        Default:     5

Ascension.PrestigiousCache.SecondTokenChancePercent = 5

#
#    Ascension.PrestigiousCache.ClassicStages
#        描述：额外的经典池上限，0-8。池还必须由
#                     Ascension.CallboardCache.ReleaseStage 发布。现有层级缓存同时遵守这两个限制。
#                     池顺序：从 1287304 开始，依次为英雄地下城、祖尔格拉布、熔火之心、
#                     奥妮克希亚、黑翼之巢、安其拉废墟、安其拉神殿、
#                     纳克萨玛斯。通用的“最近可用的威望缓存”
#                     解析为允许的最新且已填充的池。
#        Default:     8

Ascension.PrestigiousCache.ClassicStages = 8

#
#    Ascension.PrestigiousCache.TbcStages
#        Description: 已发布多少个燃烧的远征 Prestigious Cache，0-9，
#                     按顺序 1297310 依次对应
#                     卡拉赞、格鲁尔的巢穴、玛瑟里顿的巢穴、
#                     毒蛇神殿、风暴要塞、祖阿曼、海加尔山之战、黑暗神殿、太阳井。
#                     零将通用 cache 保持在 Classic 阶梯上。
#        Default:     0

Ascension.PrestigiousCache.TbcStages = 0

#
#    Ascension.CallboardCache.ReleaseStage
#        Description: 服务器当前的内容进度阶段，0-8。
#                     每个阶段也会同时开放其之前的所有阶段：
#                     0 - 仅普通地下城
#                     1 - 英雄地下城
#                     2 - 史诗地下城
#                     3 - 熔火之心
#                     4 - 祖尔格拉布
#                     5 - 奥妮克希亚的巢穴
#                     6 - 黑翼之巢
#                     7 - 安其拉废墟和安其拉神殿
#                     8 - 纳克萨玛斯
#                     高于该阶段的团队副本或地下城难度将处于关闭状态：
#                     进入时会显示“副本已关闭”，
#                     若角色在副本内登录则会被移出。游戏管理员仍可进入；其他地图不受影响。
#                     客户端只有在英雄和史诗难度开放后才会列出它们。
#                     公告板缓存遵循相同的阶段：只有已开放的缓存才会被获得，
#                     通用公告板缓存会解析为已开放的层级。
#                     通过 .reload config 应用；客户端的难度列表在下次登录时更新。
#        Default:     3

Ascension.CallboardCache.ReleaseStage = 0
#
#    Ascension.CallboardCache.PreviousStageOnly
#        说明：将每个通用 Callboard Cache 保持在已发布阶段低一个阶段。
#                     1378050 cache 承诺“装备达到上一个已发布层级”，
#                     无论此设置如何，它自己都会在那里停止。
#        Default:     0

Ascension.CallboardCache.PreviousStageOnly = 0

#
#    Ascension.CallboardCache.ItemLevelAllowance
#        Description: Callboard Cache 可以超过开启者平均装备物品等级多少：
#                     “此 Callboard Cache 根据你的物品等级给予奖励。”
#                     奖励优先在开启者自身等级或以上，
#                     永远不会超过此允许值。
#        Default:     6

Ascension.CallboardCache.ItemLevelAllowance = 6

#
#    Ascension.CallboardCache.CachePoints
#        Description: 支付一个宝库的 Callboard 宝库进度点数。每个 Callboard
#                     任务会从 ascension_callboard_quest_points 中添加其点数；满
#                     进度条会支付在角色达到的最高平均物品等级等于或低于时，已发布的
#                     ascension_callboard_cache_tier 行中最高层级的宝库，
#                     剩余点数会结转。客户端显示每项数额的十分之一：
#                     150 点的进度条显示为 15，25 点的任务显示为 3（向上取整）。
#        Default:     150

Ascension.CallboardCache.CachePoints = 150

#
#    Ascension.CallboardCache.GoldMin
#    Ascension.CallboardCache.GoldMax
#        Description: 当 Callboard 宝库开启时，在物品之外支付的金币，
#                     在这两个数额之间随机。
#        Default:     5, 15

Ascension.CallboardCache.GoldMin = 5
Ascension.CallboardCache.GoldMax = 15

#
#    CoA.DungeonTuning.Enable
#        Description: 允许在 5 人地下城中使用 .mythic damage 和 .mythic health。每个玩家都可以
#                     按百分比提高或降低自己副本中生物造成的伤害和生命值，以试验数值；
#                     每次更改都会记录为一行 TUNING 日志。
#                     用于测试服；在正式服上请关闭。
#        Default:     1

CoA.DungeonTuning.Enable = 0

#
#    CoA.DungeonNormal.Enable
#        Description: 5人地下城中飞升首领套件的普通难度调整。
#                     coa_dungeon_normal_spell_damage 中列出的
#                     套件法术造成飞升普通难度伤害（50级以下的施法者）或英雄伤害 /1.66 * 0.85，
#                     不包含地下城生物伤害缩放，且其重复计时器运行更久。
#        Default:     1

CoA.DungeonNormal.Enable = 1

#
#    CoA.DungeonNormal.RepeatFactor
#        Description: 普通难度下首领套件法术的冷却时间延长多少（1.1 = 延长 10%）。
#        Default:     1.1

CoA.DungeonNormal.RepeatFactor = 1.1

#
#    CoA.DungeonNormal.AreaHitCapPct
#    CoA.DungeonNormal.TargetHitCapPct
#        Description: 普通难度下，首领套件法术的任何单次命中造成的伤害不超过玩家最大生命值的该比例：
#                     范围法术 / 单体法术。0 表示关闭上限。
#        Default:     25, 40

CoA.DungeonNormal.AreaHitCapPct = 25
CoA.DungeonNormal.TargetHitCapPct = 40

#
#    CoA.TestZoneBonus.AnnounceIntervalMinutes
#        Description: 每隔多久向每位玩家告知哪些测试区域处于激活状态以及他们在那里能获得什么
#                     这些区域本身位于 coa_test_zone_bonus 中，并通过.testzone 进行管理；
#                     将某个区域设为测试区域总是会公告。0 关闭该提醒。
#        Default:     15

CoA.TestZoneBonus.AnnounceIntervalMinutes = 0

