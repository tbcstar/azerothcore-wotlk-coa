MaxArenaPoints = 10000

#
#    StartArenaPoints
#        Description: 角色创建后拥有的竞技场点数。
#        Default:     0

StartArenaPoints = 0

#
#   Arena.LegacyArenaPoints
#        Description: 当等级小于或等于 1500 时，对第 1-5 赛季使用 TBC 的竞技场点数计算
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Arena.LegacyArenaPoints = 0

#
#    Rate.ArenaPoints
#        Description: 竞技场点数获取倍率。
#        Default:     1

Rate.ArenaPoints = 1

