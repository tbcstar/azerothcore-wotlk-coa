#
# CoA：百变（暗月 - 第10赛季）
#
# 一个百变服务器还会在它们自己的文件中设置：
#     CoAChallenges.GameModes.Realm = WildCard
#     CoA.GameModeMask = 64
#     CoA.ClientBooleanConfigs = "CONFIG_LEGACY_CHARACTER_ADVANCEMENT_ENABLED=0"
#     CoA.ClassModel = "hero"
#     CoA.MapClass10ToWarrior = 0
#     CoA.RealmType = "live seasonal"
#     PlayerStart.CustomSpells = 1
#     AlwaysMaxSkillForLevel = 1
#

[worldserver]

#    Wildcard.Synergy.ChancePercent
#        描述：百变等级、卷轴或快速掷骰成为协同掷骰的百分比几率。
#                     协同掷骰会按每个候选者的协同分数比例抽取，该分数是
#                     以下权重对构筑已有每个条目的总和；分数为0的候选者
#                     被排除。所有其他掷骰，以及没有任何评分候选者的协同掷骰，
#                     都会从整个池中均匀抽取。
#                     范围 0-100：0 = 从不，100 = 当有候选者适合构筑时总是。
#                     所有 Wildcard.Synergy 选项在 .reload config 后立即生效；
#                     世界服务器日志随后会显示正在使用的值。
#        Default:     65

Wildcard.Synergy.ChancePercent = 65

#    Wildcard.Synergy.LinkWeight
#    Wildcard.Synergy.RelatedWeight
#    Wildcard.Synergy.SpecTagWeight
#    Wildcard.Synergy.SchoolTagWeight
#    Wildcard.Synergy.TooltipWeight
#        描述：每个范围 0-1000；更大的值会被降低到 1000。只有权重之间的
#                     比例重要：3/2/2/1/3 的掷骰结果与 30/20/20/10/30 完全相同，提高
#                     一个权重会使该类协同比其他类更可能。0 会关闭一种
#                     类型。负值不可能：服务器会拒绝它们，记录一个
#                     错误并保留默认值。

#    Wildcard.Synergy.LinkWeight
#        描述：候选者与构建条目之间每个法术修饰符链接的分数：
#                     一个天赋通过其法术类别掩码修改该技能，或者该天赋
#                     修改的技能（例如强化火球术和火球术）。
#        Default:     3

Wildcard.Synergy.LinkWeight = 3

#    Wildcard.Synergy.RelatedWeight
#        描述：每个跨职业关系的分数：一个天赋与另一个职业的技能，其法术
#                     学派和效果与该天赋修改的技能相同（例如一个
#                     火球术和灼烧的天赋，两者都是火焰直接伤害）。武器攻击
#                     只与武器攻击相关，所以法术天赋不会拉入近战攻击。
#        Default:     2

Wildcard.Synergy.RelatedWeight = 2

#    Wildcard.Synergy.SpecTagWeight
#        描述：候选者与构筑条目共享的每个专精的分数，取自
#                     法术标签，例如“法师：火焰”或“战士：武器”。
#        Default:     2

Wildcard.Synergy.SpecTagWeight = 2

#    Wildcard.Synergy.SchoolTagWeight
#        描述：候选者与构筑条目共享的每个法术学派的分数
#                     （物理、火焰、冰霜、自然、神圣、暗影、奥术）。武器攻击保持
#                     其学派独立：火焰近战或远程打击匹配其他火焰武器
#                     攻击，而不是火焰法术，所以施法者不会被拉入近战。天赋计入
#                     它们修改的技能的法术学派。
#        Default:     1

Wildcard.Synergy.SchoolTagWeight = 1

#    Wildcard.Synergy.TooltipWeight
#        描述：天赋提示中命名的每个技能的分数，双向计算（表
#                     ascension_wildcard_tooltip_links，例如导电毒液与闪电箭、
#                     连锁闪电和毒蛇钉刺）。Ascension 的许多天赋交互
#                     是脚本化的，仅在提示中可见。
#        Default:     3

Wildcard.Synergy.TooltipWeight = 3

#    Wildcard.Synergy.TalentsNeedTarget
#        描述：改变特定技能的天赋（法术修饰符，或其
#                     提示中命名的技能，例如一个雕文）仅在构筑拥有至少一个
#                     这些技能时才会被掷出。没有此类目标的天赋总是可能，
#                     并且仍然会授予已插入的天赋卡。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Wildcard.Synergy.TalentsNeedTarget = 1

#    Wildcard.Synergy.LogRolls
#        描述：将每次等级、卷轴和快速掷骰的原因写入世界服务器
#                     日志：协同或随机掷骰，条目的分数，其在总数中的份额以及
#                     哪些构建条目给出了分数。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Wildcard.Synergy.LogRolls = 1
