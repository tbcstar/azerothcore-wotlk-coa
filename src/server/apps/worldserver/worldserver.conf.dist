#        默认：4 - （所有地图）
#                     3 - （战场）
#                     2 - （仅 FFA 区域，如古拉巴什竞技场）
#                     1 - （战场和 FFA 区域）

PvPToken.MapAllowType = 4

#
#    PvPToken.ItemID
#        Description: 如果启用 PvP 令牌系统，
