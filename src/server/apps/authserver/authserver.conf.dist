###############################################
# AzerothCore 认证服务器配置文件			  #
###############################################
[authserver]

###################################################################################################
# SECTION INDEX
#
#    EXAMPLE CONFIG			示例配置
#    AUTH SERVER SETTINGS	认证服务器设置
#    MYSQL SETTINGS			MySQL 设置
#    CRYPTOGRAPHY			加密设置
#    UPDATE SETTINGS		更新设置
#    LOGGING SYSTEM SETTINGS日志系统设置
#    NETWORK				网络
#
###################################################################################################

###################################################################################################
# EXAMPLE CONFIG	示例配置
#
#    Variable	变量
#        Description: Brief description what the variable is doing.
#        Important:   Annotation for important things about this variable.
#        Example:     "Example, i.e. if the value is a string"
#        Default:     10 - (Enabled|Comment|Variable name in case of grouped config options)
#                     0  - (Disabled|Comment|Variable name in case of grouped config options)
#
# Note to developers:
# - Copy this example to keep the formatting.
# - Line breaks should be at column 100.
###################################################################################################

###################################################################################################
# AUTH SERVER SETTINGS-认证服务器设置
#
#    LogsDir
#        Description: 日志目录设置。
#        Important:   LogsDir 需要使用引号，因为字符串可能包含空格字符。
#                     日志目录必须存在，否则将禁用日志文件创建。
#        Example:     "/home/youruser/azerothcore/logs"
#        Default:     "" - (日志文件将存储在 current 路径中)

LogsDir = "/root/azerothcore-coa/env/dist/log"

#
#    MaxPingTime
#        Description: 数据库 ping 之间的时间间隔（以分钟为单位）。
#        Default:     30

MaxPingTime = 30

#
#    RealmServerPort
#        Description: 用于访问认证服务器的 TCP 端口。
#        Default:     3724

RealmServerPort = 3724

#
#
#    BindIP
#        Description: 将认证服务器绑定到 IP/主机名
#        Default:     "0.0.0.0" - (绑定到系统上的所有 IP)

BindIP = "0.0.0.0"

#
#    EnableProxyProtocol
#        Description: 启用代理协议 v2。当你的服务器位于代理之后时，
#                     负载均衡器或类似组件，你需要在此服务器和代理/负载均衡器上
#                     启用代理协议 v2 以跟踪玩家的真实 IP 地址。
#        Example:     1 - (Enabled)
#        Default:     0 - (Disabled)

EnableProxyProtocol = 0

#
#    PidFile
#        Description: 认证服务器 PID 文件。
#        Example:     "./authserver.pid"  - (Enabled)
#        Default:     ""                  - (Disabled)

PidFile = ""

#
#    UseProcessors
#        Description: 基于 Windows 和 Linux 的多处理器系统的处理器掩码。
#        Example:  对于具有 3 个 CPU 的计算机：
#                     1 - 仅第 1 个 CPU
#                     2 - 仅第 2 个 CPU
#                     4 - 仅第 3 个 CPU
#                     6 - 第 2 个 + 第 3 个 CPU，因为 "2 | 4" -> 6
#        Default:     0  - (由操作系统选择)
#                     1+ - (所选处理器的位掩码值)

UseProcessors = 0

#
#    ProcessPriority
#        Description: 基于 Windows 和 Linux 系统的进程优先级设置。
#        Details:     在 Linux 上，使用 nice 值 -15。（需要超级用户权限）。在 Windows 上，进程设置为 HIGH 类。
#        Default:     0 - (Normal)
#                     1 - (High)

ProcessPriority = 0

#
#    RealmsStateUpdateDelay
#        Description: 领域列表更新之间的时间间隔（以秒为单位）。
#        Default:     20 - (Enabled)
#                     0  - (Disabled)

RealmsStateUpdateDelay = 20

#
#    WrongPass.MaxCount
#        Description: 在账户或 IP 被禁用之前，使用错误密码登录的尝试次数。
#                     封禁。
#        Default:     0  - (Disabled)
#                     1+ - (Enabled)

WrongPass.MaxCount = 0

#
#    WrongPass.BanTime
#        Description: 对无效登录尝试封禁账户或 IP 的时间（以秒为单位）。
#        Default:     600 - (10 分钟)
#                     0   - (永久封禁)

WrongPass.BanTime = 600

#
#    WrongPass.BanType
#        Description: 无效登录尝试的封禁类型。
#        Default:     0 - (Ban IP)
#                     1 - (Ban Account)

WrongPass.BanType = 0

#
#    WrongPass.Logging
#        Description: 额外记录尝试的错误密码日志
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

WrongPass.Logging = 0

#
#    BanExpiryCheckInterval
#        Description: 检查过期封禁之间的时间间隔（以秒为单位）
#        Default:     60
#

BanExpiryCheckInterval = 60

#
#    StrictVersionCheck
#        Description: 阻止修改过的客户端连接
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#

StrictVersionCheck = 0

#
#    SourceDirectory
#        Description: 你的 AzerothCore 源代码目录的路径。
#                     如果路径留空，则使用内置的 CMAKE_SOURCE_DIR。
#        Example:     "../AzerothCore"
#        Default:     ""
#

SourceDirectory = "/root/azerothcore-coa"

#
#    MySQLExecutable
#        Description: 你的 MySQL CLI 二进制文件的路径。
#                     If the path is left empty, built-in path from cmake is used.
#        Example:     "C:/Program Files/MySQL/MySQL Server 8.4/bin/mysql.exe"
#                     "mysql.exe"
#                     "/usr/bin/mysql"
#        Default:     ""
#

MySQLExecutable = ""

#
#    TempDir
#        Description: 临时目录设置。
#        Important:   TempDir 需要使用引号，因为字符串可能包含空格字符。
#                     TempDir 目录必须存在，否则服务器无法正常工作
#        Example:     "/home/youruser/azerothcore/temp"
#        Default:     "" - (临时文件将存储在 current 路径中)

TempDir = "/root/azerothcore-coa/env/dist/temp"

#
#    IPLocationFile
#        Description: 你的 IP2Location 数据库 CSV 文件的路径。
#        Example:     "C:/acore/IP2LOCATION-LITE-DB1.CSV"
#                     "/home/acore/IP2LOCATION-LITE-DB1.CSV"
#        Default:     ""  - (Disabled)

IPLocationFile = ""

#
#    AllowLoggingIPAddressesInDatabase
#        Description: 指定是否可以将 IP 地址记录到数据库中
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

AllowLoggingIPAddressesInDatabase = 1

#
###################################################################################################

###################################################################################################
# MYSQL SETTINGS-MySQL 设置
#
#    LoginDatabaseInfo
#        Description: 领域服务器的数据库连接设置。
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (在 Windows 上使用命名管道
#                                                                 "enable-named-pipe" 添加到 [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (在 Unix/Linux 上
#                                                                           使用 Unix 套接字)
#        Default:     "127.0.0.1;3306;acore;acore;acore_auth"

LoginDatabaseInfo = "127.0.0.1;3306;acore;A112233a;acore_auth"

#
#    Database.Reconnect.Seconds
#    Database.Reconnect.Attempts
#
#        Description: 每次重连尝试之间间隔多少秒
#                     以及总共将执行多少次尝试
#        Default:     每 15 秒尝试 20 次
#

Database.Reconnect.Seconds = 15
Database.Reconnect.Attempts = 20

#
#    LoginDatabase.WorkerThreads
#        Description: 生成用于处理异步（延迟）MySQL 语句的工作线程数量。
#                     每个工作线程都镜像有自己的连接，用于
#        Default:     1

LoginDatabase.WorkerThreads = 1

#
#    LoginDatabase.SynchThreads
#        Description: 生成用于处理的 MySQL 连接数量。
#        Default:     1 - (LoginDatabase.WorkerThreads)
#

LoginDatabase.SynchThreads = 1

#
###################################################################################################

###################################################################################################
# CRYPTOGRAPHY-加密设置

#
#    TOTPMasterSecret
#        Description: 用于加密 TOTP 密钥以存储到数据库的主密钥。
#                     如果你想更改此项，请取消注释 TOTPOldMasterSecret，然后复制
#                     你的旧密钥到那里并启动一次 authserver。之后，你可以重新
#                     注释该行并删除旧密钥。
#
#        Default:     <blank> - (以未加密方式存储 TOTP 密钥)
#        Example:     000102030405060708090A0B0C0D0E0F

TOTPMasterSecret =
# TOTPOldMasterSecret =

#
###################################################################################################

###################################################################################################
# REALM CARDS-服务器选择卡片
#
#    RealmCards.Enable
#        Description: 额外为每个服务器列出一个离线卡片条目，命名为
#                     "realm!expansion!gamemode!image!unlocked!page!index!spell"。Ascension 客户端的
#                     服务器列表从这些条目读取其卡片，并隐藏没有卡片的服务器。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

RealmCards.Enable = 1

#
#    RealmCards.Category
#        Description: 卡片条目的服务器类别（Cfg_Categories.dbc id）。客户端仅从
#                     其最后一个类别读取卡片，因此这必须排在每个服务器自身类别
#                     （realmlist.timezone）之后。
#        Default:     41

RealmCards.Category = 41

#
#    RealmCards.Expansion
#    RealmCards.GameMode
#    RealmCards.Image
#        Description: 卡片资料片（EXPANSION_COLORS 索引）、游戏模式（Enum.RealmGameMode，
#                     11 = Conquest of Azeroth) 和背景 (Interface\Glues\RealmList\<image>).
#        Default:     2, 11, "Default"

RealmCards.Expansion = 2
RealmCards.GameMode = 11
RealmCards.Image = "Default"

#
###################################################################################################

###################################################################################################
# UPDATE SETTINGS-更新设置
#
#    Updates.EnableDatabases
#        Description: 描述应更新哪些数据库的掩码。
#
#        以下标志可用
#           DATABASE_LOGIN     = 1, // Auth database
#
#        Default:     0  - (All Disabled)
#                     1  - (All Enabled)

Updates.EnableDatabases = 1

#
#    Updates.AutoSetup
#        Description: 自动填充空数据库。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.AutoSetup = 1

#
#    Updates.Redundancy
#        Description: 通过哈希执行数据冗余检查
#                     以检测 SQL 更新的更改并重新应用。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.Redundancy = 1

#
#    Updates.ArchivedRedundancy
#        Description: 检查已归档更新的哈希（会减慢启动速度）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Updates.ArchivedRedundancy = 0

#
#    Updates.AllowRehash
#        Description: 如果文件哈希留空，则将当前文件哈希插入数据库。
#                     如果你想将文件标记为已应用但不知道其哈希，则此选项很有用。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.AllowRehash = 1

#
#    Updates.CleanDeadRefMaxCount
#        Description: 清理因更新被删除或重命名并在一步中编辑而出现的死引用/孤立引用。
#                     仅当缺失更新的数量低于或等于 Updates.CleanDeadRefMaxCount 值时才开始清理。
#                     这样可以防止因错误的源目录状态（可能是错误的分支或不良修订）而擦除更新历史。
#                     如果你想了解数据库是否处于可能的“脏状态（dirty state）”，请禁用此选项。
#        Default:     3 - (Enabled)
#                     0 - (Disabled)
#                    -1 - (Enabled - 无限制)

Updates.CleanDeadRefMaxCount = 3
###################################################################################################

###################################################################################################
#
#  LOGGING SYSTEM SETTINGS-日志系统设置
#
#  Appender config values: 给定一个 appender “名称”
#    Appender.name
#        Description: 定义“记录到哪里”
#        Format:      Type,LogLevel,Flags,optional1,optional2,optional3
#
#                     Type
#                         0 - （无）
#                         1 - （控制台）
#                         2 - （文件）
#                         3 - （数据库）
#
#                     LogLevel
#                         0 - （禁用）
#                         1 - （致命）
#                         2 - （错误）
#                         3 - （警告）
#                         4 - （信息）
#                         5 - （调试）
#                         6 - （跟踪）
#
#                     Flags:
#                         0 - 无
#                         1 - 为文本添加时间戳前缀
#                         2 - 为文本添加日志级别前缀
#                         4 - 为文本添加日志过滤器类型前缀
#                         8 - 将时间戳附加到日志文件名。格式：YYYY-MM-DD_HH-MM-SS（仅与 Type = 2 一起使用）
#                        16 - 覆盖前备份现有文件（仅与 Mode = w 一起使用）
#
#                     Colors (如果 Type = Console，则读取为 optional1)
#                         Format: "fatal error warn info debug trace"
#                         0 - 黑色
#                         1 - 红色
#                         2 - 绿色
#                         3 - 棕色
#                         4 - 蓝色
#                         5 - 品红
#                         6 - 青色
#                         7 - 灰色
#                         8 - 黄色
#                         9 - 浅红
#                        10 - 浅绿
#                        11 - 浅蓝
#                        12 - 浅品红
#                        13 - 浅青
#                        14 - 白色
#                         Example: "1 9 3 6 5 8"
#
#                     File：文件名（如果 Type = File，则读取为 optional1）
#                         允许使用一个 "%s" 来创建动态文件
#
#                     Mode：打开文件的模式（如果 Type = File，则读取为 optional2）
#                          a - （追加）
#                          w - （覆盖
#
#                     MaxFileSize：创建新日志文件之前的最大日志文件大小
#                     （如果 Type = File，则读取为 optional3）
#                         大小以字节为单位，使用 64 位无符号整数表示。
#                         最大值为 4294967295（4 GB）。留空表示无限制。
#                         注意：不适用于动态文件名。
#                         Example:  536870912 (512 MB)
#

Appender.Console=1,5,0,"1 9 3 6 5 8"
Appender.Auth=2,5,0,Auth.log,w

#  Logger 配置值：给定一个 logger “名称”
#    Logger.name
#        说明：定义“记录什么”
#        格式：LogLevel,AppenderList
#
#                     LogLevel
#                         0 - （禁用）
#                         1 - （致命）
#                         2 - （错误）
#                         3 - （警告）
#                         4 - （信息）
#                         5 - （调试）
#                         6 - （跟踪）
#
#                     AppenderList：链接到 logger 的 appender 列表
#                     （使用空格作为分隔符）。
#

Logger.root=4,Console Auth

#
###################################################################################################

###################################################################################################
# NETWORK-网络
#
#    Network.UseSocketActivation
#        说明：[仅限 Linux 功能] 为 authserver 启用 systemd 套接字激活支持。
#                     启用后，当进程由 systemd 套接字激活启动时，
#                     服务器将使用 systemd 传递的套接字，而不是
#                     创建并绑定自己的监听套接字。默认禁用。
#
#        Example:     1 - (Enabled)
#        Default:     0 - (Disabled)

Network.UseSocketActivation = 0

#
###################################################################################################
