###################################################################################################
# DYNAMIC RESPAWN SETTINGS-动态重生设置
#
#
#    Respawn.DynamicRateCreature
#        说明：控制生物重生时间如何根据区域中的玩家数量调整。
#                     重生时间在配置的玩家数量之前保持不变。
#                     当玩家数量超过此值时，重生时间按比例减少
#                     （例如，玩家数量翻倍时，重生时间减半；玩家数量三倍时，重生速度提高三倍）。
#                     不影响副本生物、首领或任务给予者。
#        Formula:     adjustFactor = rate / playerCount
#                     RespawnTime = RespawnTime * adjustFactor
#        Default:     1 (Disabled)

Respawn.DynamicRateCreature = 1

#
#    Respawn.DynamicMinimumCreature
#        Description: The minimum respawn time for a creature under dynamic scaling.
#        Default:     10 - (10 seconds)

Respawn.DynamicMinimumCreature = 10

#
#    Respawn.DynamicRateGameObject
#        说明：控制游戏对象重生时间如何根据区域中的玩家数量调整。
#                     重生时间在配置的玩家数量之前保持不变。
#                     当玩家数量超过此值时，重生时间按比例减少
#                     （例如，玩家数量翻倍时，重生时间减半；玩家数量三倍时，重生速度提高三倍）。
#                     不影响副本对象或任务给予者。
#        Formula:     adjustFactor = rate / playerCount
#                     RespawnTime = RespawnTime * adjustFactor
#        Default:     1 (Disabled)

Respawn.DynamicRateGameObject = 1

#
#    Respawn.DynamicMinimumGameObject
#        Description: The minimum respawn time for a gameobject under dynamic scaling.
#        Default:     10 - (10 seconds)

Respawn.DynamicMinimumGameObject = 10

#
#    Respawn.DynamicEscortNPC
#        Description: Enable dynamic respawn behavior for escort quest NPCs.
#                     When enabled, escort NPCs in spawn groups flagged as ESCORTQUESTNPC
#                     will use special respawn handling.
#        Default:     0 - (Disabled)

Respawn.DynamicEscortNPC = 0

#
#    Respawn.ForceCompatibilityMode
#        Description: Force all spawns to use legacy (compatibility mode) respawn behavior,
#                     regardless of their spawn group flags. When enabled, creatures and
#                     gameobjects respawn in-place as they always have in AzerothCore.
#                     Set to 1 to force legacy behavior for all spawns.
#        Default:     0 - (Disabled, spawn groups control respawn mode)

Respawn.ForceCompatibilityMode = 0

