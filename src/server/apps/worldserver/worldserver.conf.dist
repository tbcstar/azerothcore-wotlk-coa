################################################
# AzerothCore 世界服务器配置文件			   #
################################################
[worldserver]

###################################################################################################
# SECTION INDEX
#
#  SERVER SYSTEM SETTINGS				服务器系统设置
#    DATABASE & CONNECTIONS				数据库与连接
#    DIRECTORIES						目录
#    CONSOLE							控制台
#    AUTOUPDATER						自动更新
#    NETWORK							网络
#    REMOTE ACCESS						远程访问
#    CRYPTOGRAPHY						加密
#    PERFORMANCE						性能
#    LOGGING							日志
#    METRIC								指标
#    SERVER								服务器
#    PACKET SPOOF PROTECTION SETTINGS	数据包欺骗防护设置
#    WARDEN
#    AUTO BROADCAST						自动广播
#    VISIBILITY AND DISTANCES			可见性与距离
#    MAPS								地图
#    WEATHER							天气
#    TICKETS							工单
#    COMMAND							命令
#
#  GAME SETTINGS						游戏设置
#    GAME MASTER						游戏管理员
#    CHEAT								作弊
#    ACCOUNT							账户
#    CHARACTER DATABASE					角色数据库
#    CHARACTER DELETE					角色删除
#    CHARACTER CREATION					角色创建
#    CHARACTER							角色
#    ACHIEVEMENT						成就
#    SKILL								技能
#    STATS								属性
#    REPUTATION							声望
#    EXPERIENCE							经验
#    CURRENCY							货币
#    DURABILITY							耐久度
#    DEATH								死亡
#    PET								宠物
#    ITEM DELETE						物品删除
#    ITEM								物品
#    QUEST								任务
#    CREATURE							生物
#    VENDOR								商人
#    GROUP								队伍
#    INSTANCE							副本
#    DUNGEON AND BATTLEGROUND FINDER	地下城与战场查找器
#    CHARTER							公会章程
#    GUILD								公会
#    FFAPVP								自由PVP
#    OUTDOORPVP							户外PVP
#    WINTERGRASP						冬拥湖
#    BATTLEGROUND						战场
#    ARENA								竞技场
#    MAIL								邮件
#    TRANSPORT							运输
#    CHAT CHANNEL						聊天频道
#    FACTION INTERACTION				阵营交互
#    RECRUIT A FRIEND					招募好友
#    CALENDAR							日历
#    GAME EVENT							游戏事件
#    AUCTION HOUSE						拍卖行
#    PLAYER DUMP						玩家转储
#    CUSTOM								自定义
#    DEBUG								调试
#    DYNAMIC RESPAWN SETTINGS			动态重生设置
#
#  CLUSTER SETTINGS						集群设置
#
###################################################################################################

###################################################################################################
#                                                                                                 #
# SERVER SYSTEM SETTINGS BEGIN-服务器系统设置开始                                                 #
#                                                                                                 #
###################################################################################################

###################################################################################################
# DATABASE & CONNECTIONS-数据库与连接
#
#    RealmID
#        说明：使用此配置的领域 ID。
#        重要：RealmID 必须与认证数据库中的 realmlist 匹配。
#        Default:     1

RealmID = 1

#
#    WorldServerPort
#        Description: 用于访问世界服务器的 TCP 端口。
#        Default:     8085

WorldServerPort = 8085

#
#    BindIP
#        Description: 将世界服务器绑定到 IP/主机名
#        Default:     "0.0.0.0" - (绑定到系统上的所有 IP)

BindIP = "0.0.0.0"

#
#    LoginDatabaseInfo
#    WorldDatabaseInfo
#    CharacterDatabaseInfo
#        Description: 世界服务器的数据库连接设置。
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database"
#                     (在 Windows 上使用命名管道，将 "enable-named-pipe" 添加到 [mysqld] section my.ini)
#                     ".;/path/to/unix_socket;username;password;database"
#                     (在 Unix/Linux 上使用 Unix 套接字)
#        Default:     "127.0.0.1;3306;acore;acore;acore_auth"       - (LoginDatabaseInfo)
#                     "127.0.0.1;3306;acore;acore;acore_world"      - (WorldDatabaseInfo)
#                     "127.0.0.1;3306;acore;acore;acore_characters" - (CharacterDatabaseInfo)

LoginDatabaseInfo     = "127.0.0.1;3306;acore;A112233a;acore_auth"
WorldDatabaseInfo     = "127.0.0.1;3306;acore;A112233a;acore_world"
CharacterDatabaseInfo = "127.0.0.1;3306;acore;A112233a;acore_characters"

#
#    LoginDatabase.WorkerThreads
#    WorldDatabase.WorkerThreads
#    CharacterDatabase.WorkerThreads
#        Description: 生成用于处理异步（延迟）MySQL 语句的工作线程数量。
#                     每个工作线程都镜像有自己的 MySQL 服务器连接，
#                     并在 MySQL 服务器上有自己的线程。
#        Default:     1 - (LoginDatabase.WorkerThreads)
#                     1 - (WorldDatabase.WorkerThreads)
#                     1 - (CharacterDatabase.WorkerThreads)

LoginDatabase.WorkerThreads     = 1
WorldDatabase.WorkerThreads     = 1
CharacterDatabase.WorkerThreads = 1

#
#    LoginDatabase.TransactionIsolation
#    WorldDatabase.TransactionIsolation
#    CharacterDatabase.TransactionIsolation
#        Description: 连接池中每个连接（同步和异步）的事务隔离级别，
#                     在每次连接和重连时应用。
#                     空值保持 MySQL 服务器默认值（REPEATABLE-READ，除非服务器另有配置）。
#                     值不在 Values 下列出会导致服务器在启动时停止。
#                     READ-UNCOMMITTED 和 READ-COMMITTED 需要基于行的二进制日志
#                     （binlog_format ROW 或 MIXED，或关闭二进制日志）；使用 binlog_format
#                     STATEMENT 时服务器会在启动时停止，因为 MySQL 会拒绝每次写入。
#        Example:     "READ-COMMITTED" - (当 CharacterDatabase.WorkerThreads 大于 1 时，
#                                         避免并发角色创建时的间隙锁死锁)
#        Values:      "READ-UNCOMMITTED", "READ-COMMITTED", "REPEATABLE-READ", "SERIALIZABLE"
#        Default:     "" - (LoginDatabase.TransactionIsolation)
#                     "" - (WorldDatabase.TransactionIsolation)
#                     "" - (CharacterDatabase.TransactionIsolation)

LoginDatabase.TransactionIsolation     = ""
WorldDatabase.TransactionIsolation     = ""
CharacterDatabase.TransactionIsolation = ""

#
#    LoginDatabase.SynchThreads
#    WorldDatabase.SynchThreads
#    CharacterDatabase.SynchThreads
#        Description: 生成用于处理的 MySQL 连接数量。
#        Default:     1 - (LoginDatabase.SynchThreads)
#                     1 - (WorldDatabase.SynchThreads)
#                     1 - (CharacterDatabase.SynchThreads)

LoginDatabase.SynchThreads     = 1
WorldDatabase.SynchThreads     = 1
CharacterDatabase.SynchThreads = 1

#
#    MaxPingTime
#        Description: 数据库 ping 之间的时间间隔（以分钟为单位）。
#        Default:     30

MaxPingTime = 30

#
#    Database.Reconnect.Seconds
#    Database.Reconnect.Attempts
#        说明：每次重连尝试之间间隔多少秒
#              以及总共将执行多少次尝试
#        默认：每 15 秒尝试 20 次
#

Database.Reconnect.Seconds = 15
Database.Reconnect.Attempts = 20

#
###################################################################################################

###################################################################################################
# DIRECTORIES-目录
#
#    DataDir
#        说明：数据目录设置。
#        重要：DataDir 需要使用引号，因为字符串可能包含空格字符。
#        Example:     "@prefix@\home\youruser\azerothcore\data"
#        Default:     "."

DataDir = "/root/azerothcore-coa/env/dist/bin/data"

#
#    LogsDir
#        说明：日志目录设置。
#        重要：LogsDir 需要使用引号，因为字符串可能包含空格字符。
#                     日志目录必须存在，否则将禁用日志文件创建。
#        Example:     "/home/youruser/azerothcore/logs"
#        Default:     "" - (日志文件将存储在 current 路径中)

LogsDir = "/root/azerothcore-coa/env/dist/logs"

#
#    TempDir
#        说明：临时目录设置。
#        重要：TempDir 需要使用引号，因为字符串可能包含空格字符。
#                     TempDir 目录必须存在，否则服务器无法正常工作
#        Example:     "/home/youruser/azerothcore/temp"
#        Default:     "" - (临时文件将存储在 current 路径中)

TempDir = "/root/azerothcore-coa/env/dist/temp"

#
#    CMakeCommand
#        说明：你的 CMake 二进制文件的路径。
#                     如果路径留空，则使用内置的 CMAKE_COMMAND
#        Example:     "C:/Program Files/CMake/bin/cmake.exe"
#                     "/usr/bin/cmake"
#        Default:     ""

CMakeCommand = ""

#
#    BuildDirectory
#        说明：你的构建目录的路径。
#                     如果路径留空，则使用内置的 CMAKE_BINARY_DIR。
#        Example:     "../AzerothCore"
#        Default:     ""

BuildDirectory = ""

#
#    SourceDirectory
#        说明：你的 AzerothCore 源代码目录的路径。
#                     如果路径留空，则使用内置的 CMAKE_SOURCE_DIR。
#        Example:     "../azerothcore-wotlk"
#        Default:     ""

SourceDirectory = "/root/azerothcore-coa"

#
#    MySQLExecutable
#        说明：你的 MySQL CLI 二进制文件的路径。
#                     如果路径留空，则使用 cmake 的内置路径。
#        Example:     "C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"
#                     "mysql.exe"
#                     "/usr/bin/mysql"
#        Default:     ""

MySQLExecutable = ""

#
#    PidFile
#        Description: 世界守护进程 PID 文件。
#        Example:     "./world.pid" - (Enabled)
#        Default:     ""            - (Disabled)

PidFile = ""

#
###################################################################################################

###################################################################################################
# CONSOLE-控制台
#
#    Console.Enable
#        Description: 启用控制台。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Console.Enable = 1

#
#    BeepAtStart
#        Description: 世界服务器完成启动时发出蜂鸣声（Unix/Linux 系统）。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

BeepAtStart = 1

#
#    FlashAtStart
#        Description: 世界服务器完成启动时在任务栏闪烁。（仅适用于 Windows）
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

FlashAtStart = 1

#
###################################################################################################

###################################################################################################
# AUTOUPDATER-自动更新
#
#    Updates.EnableDatabases
#        说明：描述应更新哪些数据库的掩码。
#        注意：以下标志可用
#                     DATABASE_LOGIN     = 1, 认证数据库
#                     DATABASE_CHARACTER = 2, 角色数据库
#                     DATABASE_WORLD     = 4, 世界数据库
#        默认：7 - （全部启用）
#                     4 - （仅启用世界）
#                     0 - （全部禁用）

Updates.EnableDatabases = 7

#
#    Updates.AutoSetup
#        Description: 自动填充空数据库。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.AutoSetup   = 1

#
#    Updates.Redundancy
#        说明：通过哈希执行数据冗余检查
#                     以检测 SQL 更新的更改并重新应用。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.Redundancy  = 1

#
#    Updates.ArchivedRedundancy
#        Description: 检查已归档更新的哈希（会减慢启动速度）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Updates.ArchivedRedundancy = 1

#
#    Updates.AllowRehash
#        说明：如果文件哈希留空，则将当前文件哈希插入数据库。
#                     如果你想将文件标记为已应用但不知道其哈希，则此选项很有用。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Updates.AllowRehash = 1

#
#    Updates.CleanDeadRefMaxCount
#        说明：清理因更新被删除或重命名并在一步中编辑而出现的死引用/孤立引用。
#                     仅当缺失更新的数量低于或等于 Updates.CleanDeadRefMaxCount 值时才开始清理。
#                     这样可以防止因错误的源目录状态（可能是错误的分支或不良修订）而擦除更新历史。
#                     如果你想了解数据库是否处于可能的“脏状态（dirty state）”，请禁用此选项。
#        Default:     3 - (Enabled)
#                     0 - (Disabled)
#                    -1 - (Enabled - unlimited)

Updates.CleanDeadRefMaxCount = 3

#
#    Updates.ExceptionShutdownDelay
#        说明：发生致命异常（例如 SQL 更新失败）后，等待关闭的时间（以毫秒为单位）。
#        默认：10000 - 10 秒
#                     0     - Disabled (立即关闭)

Updates.ExceptionShutdownDelay = 10000

#
###################################################################################################

###################################################################################################
# NETWORK-网络
#
#    Network.Threads
#        说明：网络线程数。
#         默认：1 - （建议每 1000 个连接 1 个线程）

Network.Threads = 1

#
#    Network.OutKBuff
#        说明：用于输出内核缓冲区的内存量（以字节为单位）（参见 SO_SNDBUF
#                     套接字选项，TCP 手册）。
#        默认：-1 - （使用系统默认设置）

Network.OutKBuff = -1

#
#    Network.OutUBuff
#        Description: 每个连接在用户空间初始保留的用于输出缓冲的内存量
#                     （以字节为单位）。
#         Default:    4096

Network.OutUBuff = 4096

#
#    Network.TcpNoDelay:
#        说明：TCP Nagle 算法设置。
#         默认：0 - （启用，流量更少，延迟更高）
#                     1 - （禁用，流量更多，延迟更低，TCP_NO_DELAY

Network.TcpNodelay = 1

#
#    Network.EnableProxyProtocol
#        Description: 启用代理协议 v2。当你的服务器位于代理之后时，
#                     负载均衡器或类似组件，你需要在此服务器和代理/负载均衡器上
#                     启用代理协议 v2 以跟踪玩家的真实 IP 地址。
#        Example:     1 - (Enabled)
#        Default:     0 - (Disabled)

Network.EnableProxyProtocol = 0

#
#    Network.UseSocketActivation
#        Description: [仅限 Linux 功能] 为 worldserver 启用 systemd 套接字激活支持。
#                     启用后，当进程由 systemd 套接字激活启动时，
#                     服务器将使用 systemd 传递的套接字，而不是
#                     创建并绑定自己的监听套接字。默认禁用。
#                     启用后，领域在关闭时不会自动设置为离线。
#        Example:     1 - (Enabled)
#        Default:     0 - (Disabled)

Network.UseSocketActivation = 0

#
###################################################################################################

###################################################################################################
# REMOTE ACCESS-远程访问
#
#    Ra.Enable
#        Description: 启用远程控制台（telnet）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Ra.Enable = 0

#
#    Ra.IP
#        Description: 将远程访问绑定到 IP/主机名。
#        默认："0.0.0.0" - （绑定到系统上的所有 IP）

Ra.IP = "0.0.0.0"

#
#    Ra.Port
#        Description: 用于访问远程控制台的 TCP 端口。
#        Default:     3443

Ra.Port = 3443

#
#    Ra.MinLevel
#        Description: 使用远程控制台所需的安全级别。
#        Default:     3

Ra.MinLevel = 3

#
#    SOAP.Enable
#        Description: 启用 SOAP 服务
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

SOAP.Enabled = 0

#
#    SOAP.IP
#        Description: 将 SOAP 服务绑定到 IP/主机名
#        Default:     "127.0.0.1" - (Bind to localhost)

SOAP.IP = "127.0.0.1"

#
#    SOAP.Port
#        Description: 用于访问 SOAP 服务的 TCP 端口。
#        Default:     7878

SOAP.Port = 7878

#
###################################################################################################

###################################################################################################
# CRYPTOGRAPHY-加密
#
#    TOTPMasterSecret
#        Description: authserver 用于解密数据库存储中 TOTP 密钥的密钥。
#                     仅当你计划使用游戏内 2FA 管理命令（.account 2fa）时才需要在此设置，
#                     否则可以留空。
#                     如果此设置与你的 authserver 设置不匹配，服务器将自动检测，
#                     此时任何依赖该密钥的命令都将被禁用。
#        Default:     <blank>
#

TOTPMasterSecret =

#
###################################################################################################

###################################################################################################
# PERFORMANCE-性能
#
#    ThreadPool
#        Description: 用于全局线程池的线程数
#                     线程池目前用于：
#                     - 信号处理
#                     - 远程访问
#                     - 数据库保活 ping
#                     - 核心冻结检查
#                     - 世界套接字网络
#        Default:     2

ThreadPool = 2

#
#    UseProcessors
#        说明：基于 Windows 和 Linux 的多处理器系统的处理器掩码。
#        示例：对于具有 3 个 CPU 的计算机：
#                     1  - 仅第 1 个 CPU
#                     2  - 仅第 2 个 CPU
#                     4  - 仅第 3 个 CPU
#                     6  - 第 2 个 + 第 3 个 CPU，因为 "2 | 4" -> 6
#        默认：0  - （由操作系统选择）
#                     1+ - （所选处理器的位掩码值）

UseProcessors = 0

#
#    ProcessPriority
#        Description: 基于 Windows 系统的进程优先级设置。
#        Default:     1 - (High)
#                     0 - (Normal)

ProcessPriority = 1

#
#    Compression
#        Description: 客户端更新包的压缩级别
#        Range:       1-9
#        Default:     1 - (Speed)
#                     9 - (Best compression)

Compression = 1

#
###################################################################################################

###################################################################################################
# LOGGING-日志
#
#    PacketLogFile
#        说明：世界服务器的二进制数据包日志文件。
#                     文件扩展名必须为 .pkt 才能用 WowPacketParser 解析。
#        Example:     "World.pkt" - (Enabled)
#        Default:     ""          - (Disabled)

PacketLogFile = ""

#
#    LogDB.Opt.ClearInterval
#        Description: WUPDATE_CLEANDB 计时器清除 `logs` 表中旧条目的时间间隔
#                     （以分钟为单位）。
#        Default:     10 - (10 minutes)
#                     1+

LogDB.Opt.ClearInterval = 10

#
#    LogDB.Opt.ClearTime
#        说明：保留旧 `logs` 表条目的时间（以秒为单位）。
#        默认：1209600 - （启用，14 天）
#                     0       - （禁用，不清理条目）

LogDB.Opt.ClearTime = 1209600

#
#    RecordUpdateTimeDiffInterval
#        说明：将更新时间差写入日志文件的时间间隔（以毫秒为单位）。
#                     更新差可用作性能指标。差 < 300：性能良好。
#                     差 > 600：性能差，可能由高 CPU 使用率引起。
#        Default:     300000 - (Enabled, 5 minutes)
#                     0      - (Disabled)

RecordUpdateTimeDiffInterval = 300000

#
#     MinRecordUpdateTimeDiff
#        Description: 仅记录大于此值的更新时间差。
#        Default:     100

MinRecordUpdateTimeDiff = 100

#
#    IPLocationFile
#        Description: 你的 IP2Location 数据库 CSV 文件的路径。
#        Example:     "C:/acore/IP2LOCATION-LITE-DB1.CSV"
#                     "/home/acore/IP2LOCATION-LITE-DB1.CSV"
#        Default:     "" - (Disabled)

IPLocationFile = ""

#
#    AllowLoggingIPAddressesInDatabase
#        Description: 指定是否可以将 IP 地址记录到数据库中
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AllowLoggingIPAddressesInDatabase = 1

#
#    Allow.IP.Based.Action.Logging
#        Description: 记录基于当前会话 IP 的操作，例如账户登录和注销等。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Allow.IP.Based.Action.Logging = 0

#
#    LogSpamReports
#        Description: 允许将玩家在聊天、邮件或日历中的垃圾信息报告记录到数据库。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

LogSpamReports = 1

#
#    ChatLog.Enable
#        Description: 启用或禁用聊天日志（chat_log.cpp）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

ChatLog.Enable = 0

#
#    Appender 配置值：给定一个 appender “名称”
#    Appender.name
#        说明：定义“记录到哪里”。
#        格式：Type,LogLevel,Flags,optional1,optional2,optional3
#        Type:        0  - （无）
#                     1  - （控制台）
#                     2  - （文件）
#                     3  - （数据库）
#        LogLevel:    0  - （禁用）
#                     1  - （致命）
#                     2  - （错误）
#                     3  - （警告）
#                     4  - （信息）
#                     5  - （调试）
#                     6  - （跟踪）
#        Flags:       0  - 无
#                     1  - 为文本添加时间戳前缀
#                     2  - 为文本添加日志级别前缀
#                     4  - 为文本添加日志过滤器类型前缀
#                     8  - 将时间戳附加到日志文件名。格式：YYYY-MM-DD_HH-MM-SS
#                          （仅与 Type = 2 一起使用）
#                     16 - 覆盖前备份现有文件
#                          （仅与 Mode = w 一起使用）
#        Colors:      （如果 Type = Console，则读取为 optional1）
#        格式："fatal error warn info debug trace"
#                     0  - 黑色
#                     1  - 红色
#                     2  - 绿色
#                     3  - 棕色
#                     4  - 蓝色
#                     5  - 品红
#                     6  - 青色
#                     7  - 灰色
#                     8  - 黄色
#                     9  - 浅红
#                     10 - 浅绿
#                     11 - 浅蓝
#                     12 - 浅品红
#                     13 - 浅青
#                     14 - 白色
#        Example:     "1 9 3 6 5 8"
#        File:        文件名（如果 Type = File，则读取为 optional1）
#                     允许使用一个 "%s" 来创建动态文件
#        Mode:        打开文件的模式（如果 Type = File，则读取为 optional2）
#                     a - （追加）
#                     w - （覆盖）
#        MaxFileSize: 创建新日志文件之前的最大日志文件大小
#                     （如果 Type = File，则读取为 optional3）
#                     大小以字节为单位，使用 64 位无符号整数表示。
#                     最大值为 4294967295（4 GB）。留空表示无限制。
#        NOTE:        不适用于动态文件名。
#        Example:     536870912 (512 MB)

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.Server=2,5,0,Server.log,w
Appender.Playerbots=2,5,0,Playerbots.log,w
# Appender.GM=2,5,15,gm_%s.log
Appender.Errors=2,2,0,Errors.log,w
# Appender.DB=3,5,0
# Appender.Dev=2,5,0,Dev.log,a

#    Logger 配置值：给定一个 logger “名称”
#    Logger.name
#        说明：定义“记录什么”
#        格式：LogLevel,AppenderList
#        LogLevel:     0 - （禁用）
#                      1 - （致命）
#                      2 - （错误）
#                      3 - （警告）
#                      4 - （信息）
#                      5 - （调试）
#                      6 - （跟踪）
#        AppenderList：链接到 logger 的 appender 列表
#                      （使用空格作为分隔符）。
#

Logger.root=2,Console Server
# Logger.metric=2,Console Server
# Logger.commands.gm=4,Console GM
Logger.diff=3,Console Server
Logger.mmaps=4,Server
Logger.scripts.hotswap=4,Console Server
Logger.server=4,Console Server
Logger.sql.sql=2,Console Errors
Logger.sql.updates=4,Console Server Errors
Logger.sql=4,Console Server
