#
#    Log.Async.Enable
#        Description: 启用异步消息日志。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Log.Async.Enable = 0

#
###################################################################################################

###################################################################################################
# METRIC-指标
#
# 这些设置控制发送到指标数据库（目前为 InfluxDB）的统计信息
#
#    Metric.Enable
#        说明：启用发送到指标数据库的统计信息
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#

Metric.Enable = 0

#
#    Metric.InfluxDB
#        说明：InfluxDB 的连接设置。
#        对于 InfluxDB v1：仅填写 Metric.InfluxDB.Connection。
#        示例：Metric.InfluxDB.Connection = "hostname;port;database"
#        对于 InfluxDB v2：填写每个字段。
#        注意：目前，Grafana 无法使用提供的 json 文件
#              可视化来自 InfluxDB v2 的数据。
#        Example:         Metric.InfluxDB.Connection = "hostname;port"
#                         Metric.InfluxDB.v2 =         0 - (Disabled)
#                                                      1 - (Enabled)
#                         Metric.InfluxDB.Org =        "my-org"
#                         Metric.InfluxDB.Bucket =     "my-bucket"
#                         Metric.InfluxDB.Token =      "my-token"
#

Metric.InfluxDB.Connection = "127.0.0.1;8086;worldserver"
Metric.InfluxDB.v2 = 0
Metric.InfluxDB.Org = ""
Metric.InfluxDB.Bucket = ""
Metric.InfluxDB.Token = ""

#
#    Metric.Interval
#        说明：每批数据发送之间的间隔（以秒为单位）。
#                     间隔越长意味着批次越大。
#                     如果批次太大，可能会被拒绝。
#        Default:     1 second

Metric.Interval = 1

#
#    Metric.OverallStatusInterval
#        Description: 每次收集整体 worldserver 状态数据之间的间隔（以秒为单位）
#        Default:     1 second

Metric.OverallStatusInterval = 1

#
#    Metric 阈值：给定一个 metric “名称”
#    Metric.Threshold.name
#        说明：跳过发送值低于配置值的统计信息。
#                     如果阈值被注释掉，该指标将被忽略。
#                     仅影响源代码中使用 METRIC_DETAILED_TIMER 记录的指标。
#                     默认禁用。需要 WITH_DETAILED_METRICS CMake 标志。
#
#        格式：整数值
#

#Metric.Threshold.world_update_sessions_time = 100
#Metric.Threshold.worldsession_update_opcode_time = 50

#
###################################################################################################

###################################################################################################
# SERVER-服务器
#
#    BirthdayTime
#        Description: 将项目诞生日设置为 UNIX 时间。默认 2008 年 10 月 2 日星期四
#        Default:     1222964635

BirthdayTime = 1222964635

#
#    PlayerLimit
#        说明：世界中玩家的最大数量。不包括 Mods、GMs 和 Admins。
#        重要：如果你想阻止玩家，只允许 Mods、GMs 或 Admins 加入服务器，
#                     请使用数据库字段 "auth.realmlist.allowedSecurityLevel"。
#        Default:     1000 - (Enabled)
#                     1+   - (Enabled)
#                     0    - (Disabled, No limit)

PlayerLimit = 0

#
#    World.RealmAvailability
#        说明：如果启用，玩家将正常进入领域。
#                     即使领域被禁用，角色创建仍然可行。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

World.RealmAvailability = 1

#
#    GameType
#        说明：服务器领域类型。
#        默认：0  - （普通）
#                     1  - （PVP）
#                     4  - （普通）
#                     6  - （RP）
#                     8  - （RPPVP）
#                     16 - （FFA_PVP，自由 PvP 模式，类似竞技场 PvP，在所有区域
#                          除了休息激活地点和圣所）

GameType = 1

#
#    RealmZone
#        说明：服务器领域区域。设置角色等名称中允许的字母表。
#        默认：1  - （开发   - 任何语言）
#                     2  - （美国 - 扩展拉丁）
#                     3  - （大洋洲 - 扩展拉丁）
#                     4  - （拉丁美洲 - 扩展拉丁）
#                     5  - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     6  - （韩国 - 东亚）
#                     7  - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     8  - （英语 - 扩展拉丁）
#                     9  - （德语 - 扩展拉丁）
#                     10 - （法语 - 扩展拉丁）
#                     11 - （西班牙语 - 扩展拉丁）
#                     12 - （俄语 - 西里尔）
#                     13 - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     14 - （台湾 - 东亚）
#                     15 - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     16 - （中国 - 东亚）
#                     17 - （CN1 - 创建时基本拉丁，登录时任意）
#                     18 - （CN2 - 创建时基本拉丁，登录时任意）
#                     19 - （CN3 - 创建时基本拉丁，登录时任意）
#                     20 - （CN4 - 创建时基本拉丁，登录时任意）
#                     21 - （CN5 - 创建时基本拉丁，登录时任意）
#                     22 - （CN6 - 创建时基本拉丁，登录时任意）
#                     23 - （CN7 - 创建时基本拉丁，登录时任意）
#                     24 - （CN8 - 创建时基本拉丁，登录时任意）
#                     25 - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     26 - （测试服务器 - 任何语言）
#                     27 - （锦标赛 - 创建时基本拉丁，登录时任意）
#                     28 - （QA 服务器 - 任何语言）
#                     29 - （CN9 - 创建时基本拉丁，登录时任意）

RealmZone = 1

#
#    DBC.Locale
#        说明：DBC 语言设置。
#        默认：255 - （自动检测）
#                     0   - （英语）
#                     1   - （韩语）
#                     2   - （法语）
#                     3   - （德语）
#                     4   - （中文）
#                     5   - （繁体中文）
#                     6   - （西班牙语）
#                     7   - （墨西哥西班牙语）
#                     8   - （俄语）

DBC.Locale = 255

#
#    Expansion
#        说明：允许服务器使用扩展内容。检查扩展相关的地图文件、
#                     客户端兼容性以及职业/种族角色创建。
#        Default:     2 - (Expansion 2)
#                     1 - (Expansion 1)
#                     0 - (禁用，忽略并禁用扩展内容（地图、种族、职业）

Expansion = 2

#
#    ClientCacheVersion
#        说明：客户端缓存版本，用于重置客户端缓存数据。使用任何不同于数据库的值
#                     且最近未使用过的值来触发客户端缓存重置。
#        默认：0 - （使用世界数据库 version.cache_id 字段中的值）

ClientCacheVersion = 0

#
#    SocketTimeOutTime
#        说明：在角色选择屏幕上空闲连接被断开的时间
#        	   以毫秒为单位）。
#        默认：900000 - （15 分钟）

SocketTimeOutTime = 900000

#
#    SocketTimeOutTimeActive
#        Description: 登录世界后空闲连接被断开的时间
#                     （以毫秒为单位）。
#                     客户端每 30 秒发送保活数据包。不建议使用 <= 30 秒的值。
#        Default:     60000 - (1 minute)

SocketTimeOutTimeActive = 60000

#
#    MaxOverspeedPings
#        Description: 角色断开前的最大超速 ping 计数。
#        Default:     2  - (Enabled, Minimum value)
#                     3+ - (Enabled, More checks before kick)
#                     0  - (Disabled)

MaxOverspeedPings = 2

#
#    DisconnectToleranceInterval
#        Description: 允许在断开连接给定秒数后跳过队列。
#        Default:     0

DisconnectToleranceInterval = 0

#
#    EnableLoginAfterDC
#        说明：在未正常注销（点击注销并等待 20 秒）后，
#                     角色会在游戏世界中停留整整一分钟，即使客户端连接已关闭。
#                     这种行为可以防止例如通过 alt+f4 利用 Boss 战
#                     并跳过关键 Boss 技能，或在 PvP 中逃脱对手。
#                     此设置用于允许/禁止玩家重新登录到留在世界中的角色。
#        默认：1 - （通过点击 "Enter World"，玩家将重新登录到已在世界中的角色）
#                     0 - （通过点击 "Enter World"，玩家在尝试登录留在世界中的角色时会收到错误消息，
#                         并且必须等待一分钟让角色从世界中移除）

EnableLoginAfterDC = 1

#
#    MinWorldUpdateTime
#        Description: 世界更新 tick 之间的最小时间（毫秒）（用于大部分空闲的服务器）。
#        Default:     1 - (0.001 second)

MinWorldUpdateTime = 1

#
#    UpdateUptimeInterval
#        Description: 更新领域运行时间周期（以分钟为单位）。
#        Default:     10 - (10 minutes)
#                     1+

UpdateUptimeInterval = 10

#
#    MaxCoreStuckTime
#        Description: 如果服务器冻结，强制崩溃之前的时间（以秒为单位）。
#                     FreezeDetector
#        Default:     0   - (Disabled)
#                     10+ - (启用，建议 30+)
#        Note:        如果启用且设置太低，可能导致意外崩溃。

MaxCoreStuckTime = 0

#
#    SaveRespawnTimeImmediately
#        说明：在生物死亡和游戏对象使用/打开时保存重生时间。
#        默认：1 - （启用，立即保存重生时间）
#                     0 - （禁用，在网格卸载时保存重生时间）

SaveRespawnTimeImmediately = 1

#
#    Server.LoginInfo
#        Description: 在登录时显示核心版本（.server info）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Server.LoginInfo = 0

#
#    ShowKickInWorld
#        Description: 确定当玩家被踢出时
#                     是否向整个服务器广播消息
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

ShowKickInWorld = 0

#
#    ShowMuteInWorld
#        Description: 确定当玩家被禁言时
#                     是否向整个服务器广播消息。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

ShowMuteInWorld = 0

#
#    ShowBanInWorld
#        Description: 确定当玩家被封禁时
#                     是否向整个服务器广播消息。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

ShowBanInWorld = 0

#
#    MaxWhoListReturns
#        Description: 设置 /who 列表和界面中返回的最大玩家数量。
#        Default:     49 - (stable)

MaxWhoListReturns = 49

#
#    Who.ShowBots
#        说明：机器人角色是否出现在 /who 列表及其计数中。
#                     它们的会话是服务器自身的，因此由玩家机器人填充的领域
#                     可以将列表留给实际连接的玩家。
#                     机器人的其他一切不变：
#                     仍然可以在世界、聊天、队伍和好友列表中看到。
#        默认：1 - （启用，列出机器人）
#                     0 - （禁用，仅列出真实玩家）

Who.ShowBots = 1

#
#    PreventAFKLogout
#        Description: 防止 AFK 玩家被注销
#        Default:     0 - (Disabled)
#                     1 - （启用，防止 AFK 玩家在圣所区域被注销）
#                     2 - （启用，防止 AFK 玩家在所有区域被注销）

PreventAFKLogout = 0

#
###################################################################################################

###################################################################################################
# PACKET SPOOF PROTECTION SETTINGS-数据包欺骗防护设置
#
#    PacketSpoof.BanMode
#        说明：如果 PacketSpoof.Policy 等于 2，这将决定封禁模式。
#        值：0 - 封禁账户
#            1 - 封禁 IP
#        注意：出于逻辑原因，不支持按角色封禁。
#

PacketSpoof.BanMode = 0

#
#    PacketSpoof.BanDuration
#        说明：封禁持续时间（以秒为单位）。仅在 PacketSpoof.Policy 设置为 2 时有效。
#                     设置为 0 表示永久封禁。
#        默认：86400 秒（1 天）
#

PacketSpoof.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# WARDEN SETTINGS-反作弊设置
#
#    Warden.Enabled
#        Description: 启用 Warden 反作弊系统。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Warden.Enabled = 1

#
#    Warden.NumMemChecks
#        Description: 每个周期发送到客户端的 Warden 内存检查数量。
#        Default:     3 - (Enabled)
#                     0 - (Disabled)

Warden.NumMemChecks = 3

#
#    Warden.NumLuaChecks
#        Description: 每个周期发送到客户端的 Warden LUA 检查数量。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Warden.NumLuaChecks = 1

#
#    Warden.NumOtherChecks
#        Description: 每个检查周期添加到请求中的非内存检查的
#                     Warden 检查数量。
#        Default:     7 - (Enabled)
#                     0 - (Disabled)

Warden.NumOtherChecks = 7

#
#    Warden.ClientResponseDelay
#        Description: 客户端因未响应而被断开连接之前的时间（以秒为单位）。
#        Default:     600 - (10 Minutes)
#                     0 - (Disabled, client won't be kicked)

Warden.ClientResponseDelay = 600

#
#    Warden.ClientCheckHoldOff
#        说明：等待发送下一个检查请求到客户端的时间（以秒为单位）。
#                     数值低会增加客户端和服务器端的流量和负载。
#        默认：30 - （30 秒）
#                     0  - （尽快发送检查）

Warden.ClientCheckHoldOff = 30

#
#    Warden.ClientCheckFailAction
#        Description: 如果客户端检查失败，
#                     采取的默认操作。
#                     可以通过角色数据库中的warden_action 表为每个检查覆盖操作。
#        默认：0 - （禁用，仅记录日志）
#                     1 - （踢出）
#                     2 - （封禁）

Warden.ClientCheckFailAction = 0

#
#    Warden.BanDuration
#        Description: 如果 ClientCheckFailAction 设置为封禁，
#                     账户将被封禁的时间（以秒为单位）。
#        Default:     86400 - (24 hours)
#                     0     - (永久封禁)

Warden.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# AUTO BROADCAST-自动广播
#
#    AutoBroadcast.On
#        Description: 启用自动广播。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AutoBroadcast.On = 0

#
#    AutoBroadcast.Center
#        说明：自动广播显示方法。
#        默认：0 - （公告）
#                     1 - （通知）
#                     2 - （两者）

AutoBroadcast.Center = 0

#
#    AutoBroadcast.Timer
#        Description: 自动广播的计时器（以毫秒为单位）。
#        Default:     60000 - (60 seconds)

AutoBroadcast.Timer = 60000

#
#    AutoBroadcast.MinDisableLevel
#        说明：如果启用了 EnablePlayerSettings 选项，禁用自动广播公告所需的最低等级。
#        默认：0 - （不允许禁用

AutoBroadcast.MinDisableLevel = 0

#
###################################################################################################

###################################################################################################
# VISIBILITY AND DISTANCES-可见性与距离
#
#    Visibility.GroupMode
#        说明：队伍可见模式。定义哪些队伍可以始终检测到同一团队、队伍或阵营的隐身角色。
#        默认：1 - （团队）
#                     0 - （队伍）
#                     2 - （阵营）

Visibility.GroupMode = 1

#
#    Visibility.Distance.Continents
#    Visibility.Distance.Instances
#    Visibility.Distance.BGArenas
#        说明：看到其他玩家或游戏对象的可见距离。
#                     大陆上的可见性在正式服约 100 码。在战场/竞技场约 250。
#                     对于副本默认约 170。
#                     最大：250
#                     最小限制是最大仇恨半径（45）* Rate.Creature.Aggro
#        Default:     100 - (Visibility.Distance.Continents)
#                     170 - (Visibility.Distance.Instances)
#                     250 - (Visibility.Distance.BGArenas)

Visibility.Distance.Continents = 100
Visibility.Distance.Instances = 170
Visibility.Distance.BGArenas = 250

#
#    Visibility.ObjectSparkles
#        说明：是否在与活动任务相关的游戏对象上显示闪光。
#        默认：1 - （显示闪光）
#                     0 - （隐藏闪光）

Visibility.ObjectSparkles = 1

#
#    Visibility.ObjectQuestMarkers
#        说明：像生物任务给予者一样在游戏对象上方显示任务图标。
#        默认：1 - （显示任务标记，补丁 2.3 后行为）
#                     0 - （隐藏任务标记，补丁 2.3 前行为）

Visibility.ObjectQuestMarkers = 1

#
###################################################################################################

###################################################################################################
# MAPS-地图
#
#    MapUpdateInterval
#        Description: 地图更新间隔的时间（毫秒）。
#        Default:     10 - (0.01 second)

MapUpdateInterval = 10

#
#    MapUpdate.Threads
#        Description: 更新地图的线程数。
#        Default:     1

MapUpdate.Threads = 1

#
#    MoveMaps.Enable
#        Description: 启用/禁用使用 mmaps 的寻路 - 推荐。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

MoveMaps.Enable = 1

#
#    vmap.enableLOS
#    vmap.enableHeight
#        说明：VMmap 支持视线和高度计算。
#        默认：1 - （启用，vmap.enableLOS）
#                     1 - （启用，vmap.enableHeight）
#                     0 - （禁用）

vmap.enableLOS    = 1
vmap.enableHeight = 1

#
#    vmap.petLOS
#        说明：检查宠物的视线，以避免它们穿墙攻击。
#        默认：1 - （启用，每次宠物攻击都会检查视线）
#                     0 - （禁用，CPU 使用率略低）

vmap.petLOS = 1

#    vmap.BlizzlikePvPLOS
#        说明：检查战场和竞技场游戏对象以及其他装饰物（如 WSG 树桩）的视线。
#        默认：1 - （启用，玩家能够穿过树桩和其他物体发射法术）。
#                     0 - （禁用，玩家不能穿过树桩和其他物体发射法术）。

vmap.BlizzlikePvPLOS = 1

#
#   vmap.BlizzlikeLOSInOpenWorld
#       说明：检查开放世界中游戏对象的视线。
#       默认：1 （启用，玩家能够穿过开放世界中的树桩和其他物体施放法术）。
#                     0 （禁用，玩家不能穿过开放世界中的树桩和其他物体施放法术）。

vmap.BlizzlikeLOSInOpenWorld = 1

#
#    vmap.enableIndoorCheck
#        说明：基于 VMap 的室内检查，以移除仅限室外的光环（坐骑等）。
#        默认：1 - （启用）
#                     0 - （禁用，CPU 使用率略低）

vmap.enableIndoorCheck = 1

#
#    DetectPosCollision
#        说明：检查最终移动位置、召唤位置等与其他物体或墙壁的可见碰撞
#                     （仅在启用 vmaps 时检查墙壁）。
#        默认：1 - （启用）
#                     0 - （禁用，位置精度较低但 CPU 使用率较低）

DetectPosCollision = 1

#
#    CheckGameObjectLoS
#        说明：在视线检查中包括动态游戏对象（门、箱子等）。
#                     这会略微增加 CPU 使用率。
#        默认：1 - （启用）
#                     0 - （禁用，可能会破坏某些 Boss 战）

CheckGameObjectLoS = 1

#
#    PreloadAllNonInstancedMapGrids
#        Description: 预加载所有非实例地图上的所有网格。
#                     这将占用大量额外 RAM（约 9 GB）并导致服务器启动时间更长，
#                     但在玩家数量较多的服务器上使用可以提高性能。
#                     它还会在服务器启动时激活所有设置为活动的生物
#                     （例如地狱火半岛的恶魔掠夺者）。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PreloadAllNonInstancedMapGrids = 0

#
#     DontCacheRandomMovementPaths
#        说明：随机移动路径（使用 MoveMaps 计算）可以缓存以节省 CPU 时间，
#                     但这可能会消耗相当多的内存，可以通过将此选项设置为 1 来防止。
#                     对于人口较多的服务器，建议有足够的 RAM 并将其设置为 0。
#        默认：0 - （缓存路径，使用更多内存）
#                     1 - （不缓存，使用更多 CPU）

DontCacheRandomMovementPaths = 0

#
###################################################################################################

###################################################################################################
# WEATHER-天气
#
#    ActivateWeather
#        Description: 激活天气系统。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

ActivateWeather = 1

#
#    ChangeWeatherInterval
#        Description: 天气更新间隔的时间（毫秒）。
#        Default:     600000 - (10 min)

ChangeWeatherInterval = 600000

#
###################################################################################################

###################################################################################################
# TICKETS-工单系统
#
#    AllowTickets
#        Description: 允许/禁止发送新工单。
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AllowTickets = 1

#
#     LevelReq.Ticket
#        Description: 角色能够编写工单的等级要求。
#        Default:     1

LevelReq.Ticket = 1

#    DeletedCharacterTicketTrace
#        说明：保留已删除角色打开的工单痕迹
#                     gm_ticket.playerGuid 将为 0，旧 GUID 和角色名
#                     将包含在 gm_ticket.comment 中
#        默认：0 - （禁用）
#                     1 - （启用）

DeletedCharacterTicketTrace = 0

