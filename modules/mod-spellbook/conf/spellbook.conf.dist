[worldserver]

################################################################################################################
#    法术书
#        说明：将《Ascension 之书》作为真正的职业训练师。右键点击一本书
#                     会打开训练师窗口，显示查看者自身职业的能力，按等级排序
#                     并按等级门控，点击训练按钮学习所选技能。
#
#        Spellbook.Enable: 1（默认）提供书籍服务。
#                          0            使它们保持惰性，就像此模块不存在一样。
#
#        书籍的行为来自生物脚本 "npc_spellbook_trainer"；
#        携带它的模板由世界数据库更新设置，而不是在此处
#

#        Spellbook.Notify.Enable: 1（默认）公告每次购买。在法术被
#                                 学习之前，客户端会收到其自身 SpellCustomAttr 表中该法术的行，
#                                 并设置 "notable" 位，这正是
#                                 使其显示“学习新法术”警报并播放声音的原因。
#                                 没有这个，客户端对每一行缺少该位的法术都保持沉默
#                                 （非法力驱动的能力升级，以及表中
#                                 完全没有行的法术）：
#                                 购买成功，只显示聊天行。
#                                 0            不修改客户端的表。
#
#        Spellbook.Notify.OnClientReady: 1  还标记查看者书籍提供的每个法术，
#                                        一旦客户端报告其扩展处理器
#                                        启动，这样领域在窗口之外授予的能力
#                                        （自动进度）也会被公告。
#                                        0（默认）仅公告书籍本身学习的内容。
#                                        默认关闭，因为客户端会重建其
#                                        整个法术索引，每行它已知的内容一次，所以这
#                                        是登录时可见的暂停。
#
Spellbook.Enable = 1
Spellbook.Notify.Enable = 1
Spellbook.Notify.OnClientReady = 0

#        Spellbook.Cost.Enable: 1（默认）收取窗口显示的价格。曲线是
#                               领域自身训练师表的一半 - 等级驱动，二次方，
#                               具有相同的等级段断点 - 而实用行（工具包、皮革、
#                               钥匙、移动形态）再花费一半。参见
#                               SpellbookCostData.h 了解等级段和列表。
#                               0            免费提供一切。
#
#        Spellbook.Cost.Multiplier: 1.0（默认）按此缩放每个价格，以便
#                                   无需重建即可重新调整。
#
Spellbook.Cost.Enable = 1
Spellbook.Cost.Multiplier = 1.0
