#!/bin/sh
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

python=${PYTHON:-}
if [ -z "$python" ]; then
    if command -v python3 >/dev/null 2>&1; then python=python3
    elif command -v python >/dev/null 2>&1; then python=python
    else
        exit 0
    fi
fi

if [ "${SKIP_COMMIT_CHECKS:-0}" = "1" ]; then
    echo "[pre-commit] SKIP_COMMIT_CHECKS=1, checks skipped" >&2
    exit 0
fi

if ! "$python" -B tools/check_change_boundaries.py --base HEAD >/dev/null 2>&1; then
    echo "[pre-commit] SQL changed outside data/sql/updates/pending_db_* or a module updates/custom directory." >&2
    echo "[pre-commit] run: $python -B tools/check_change_boundaries.py --base HEAD" >&2
    exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- 'data/sql/*.sql' 'modules/*/data/sql/*.sql')
if [ -n "$staged" ]; then
    if ! printf '%s\n' "$staged" | xargs "$python" -B tools/zh_drift.py --limit 5 --paths >&2; then
        echo "[pre-commit] localization drift in the staged SQL; run the same command for the full list." >&2
        exit 1
    fi
fi

exit 0
